---
// "Choisis ton resto" picker in front of the full menu. Two stores are
// connected today (burger-nine-gex, burger-nine-roussillon) — this page is
// what keeps /carte correct the day a third one comes online, without any
// hardcoding: it just lists whatever `getBrand()` returns.
import Brand from '../../layouts/Brand.astro'
import Nav from '../../components/Nav.astro'
import Bottom from '../../components/landing/Bottom.astro'
import { getBrand } from '../../lib/api'
import { cityOf, deptLabel } from '../../lib/stores'

const brand = await getBrand()
const stores = brand.stores
---

<Brand
  title="La carte — Burger Nine"
  description="Toute la carte Burger Nine, resto par resto : burgers, tacos, bowls, box, tex-mex, desserts et boissons, avec les vrais prix."
>
  <Nav />

  <section class="sec" id="carte-picker" style="padding-top: 150px">
    <div class="wrap">
      <div class="overline">La carte</div>
      <h1 class="picker-h1">Choisis ton Nine,<br />on t'affiche sa carte.</h1>
      <p class="picker-lede">Le menu n'est pas identique partout — vois direct celui de ton resto.</p>

      <div class="picker-grid">
        {stores.map((store) => (
          <a class="picker-card" href={`/carte/${store.slug}`}>
            <span class="dep">{deptLabel(store) ?? store.address?.zipcode}</span>
            <span class="city">{cityOf(store)}</span>
            <span class="mini">
              Voir la carte
              <svg viewBox="0 0 10 12" fill="currentColor" aria-hidden="true"><path d="M0 0l10 6-10 6z" /></svg>
            </span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <Bottom />
</Brand>

<style>
  .picker-h1 {
    font-family: var(--display);
    font-weight: 800;
    font-size: clamp(34px, 5.6vw, 60px);
    line-height: 1.02;
    text-transform: uppercase;
    margin-bottom: 16px;
  }
  .picker-lede { color: var(--muted); font-size: 16.5px; max-width: 460px; margin-bottom: 40px; }
  .picker-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(240px, 1fr)); gap: 16px; max-width: 760px; }
  .picker-card {
    background: var(--panel);
    border: 1px solid var(--line);
    border-radius: 20px;
    padding: 26px 24px;
    display: flex;
    flex-direction: column;
    gap: 6px;
    transition: transform .25s, border-color .25s;
  }
  .picker-card:hover { transform: translateY(-4px); border-color: rgba(255, 45, 158, .45); }
  .picker-card .dep { font-size: 10.5px; font-weight: 800; letter-spacing: .16em; color: var(--pink); }
  .picker-card .city { font-family: var(--display); font-weight: 800; font-size: 24px; text-transform: uppercase; }
  .picker-card .mini { margin-top: 10px; font-size: 12px; font-weight: 800; letter-spacing: .08em; color: var(--pink); display: inline-flex; align-items: center; gap: 7px; text-transform: uppercase; }
  .picker-card .mini svg { width: 8px; height: 10px; }
</style>
