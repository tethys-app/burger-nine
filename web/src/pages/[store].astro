---
import Base from '../layouts/Base.astro'
import OrderIsland from '../components/OrderIsland.tsx'
import MobileHero from '../components/MobileHero.tsx'
import StoreStatus from '../components/StoreStatus.tsx'
import { getBrand, getCatalog, getStore } from '../lib/api'
import { restaurantJsonLd } from '../lib/jsonld'
import { money } from '../lib/format'
import type { Catalog, Store } from '../lib/types'

// Build-time fetch. This snapshot exists for two things only: HTML a crawler
// can read, and an instant first paint. It is allowed to be days stale —
// correctness comes from /quote at order time, never from this.
export async function getStaticPaths() {
  const brand = await getBrand()
  return Promise.all(
    brand.stores.map(async (entry) => ({
      params: { store: entry.slug },
      props: {
        store: await getStore(entry.slug),
        catalog: await getCatalog(entry.slug),
      },
    })),
  )
}

const { store, catalog } = Astro.props as { store: Store; catalog: Catalog }
const siteUrl = import.meta.env.PUBLIC_SITE_URL ?? ''
const description = `Commandez en ligne chez ${store.name}${store.address?.city ? ` à ${store.address.city}` : ''}.`
---

<Base title={`${store.name} — Commander en ligne`} description={description}>
  <script
    is:inline
    slot="head"
    type="application/ld+json"
    set:html={JSON.stringify(restaurantJsonLd(store, catalog, siteUrl))}
  />

  <main class="tasty-bg min-h-dvh">
    {/* Mobile: tall hero that morphs into a compact sticky bar on scroll. */}
    <MobileHero client:load store={store} logo="/assets/4f5b8c7fd0603355.png" />

    {/* Desktop banner, ported from the Neo app's [slug]/page.tsx. */}
    <div class="sticky top-0 z-40 hidden border-b border-hairline bg-surface/85 backdrop-blur-xl lg:block">
      <div class="mx-auto flex max-w-[1500px] items-center gap-5 px-6 py-3 pop-in">
        <a
          href="/"
          class="relative grid h-14 w-14 shrink-0 place-items-center overflow-hidden rounded-2xl transition hover:opacity-80"
          aria-label="Tous nos restos"
        >
          <img src="/assets/4f5b8c7fd0603355.png" alt="Burger Nine" class="h-full w-full object-contain" />
        </a>

        <div class="min-w-0">
          <h1 class="font-display text-lg font-black uppercase text-ink">{store.name}</h1>
          <StoreStatus client:load store={store} />
        </div>

        <div class="flex-1"></div>

        {store.phone && (
          <a
            href={`tel:${store.phone.replace(/\s/g, '')}`}
            class="shrink-0 rounded-full border border-hairline bg-elevated/50 px-3.5 py-1.5 text-[12px] font-semibold text-muted transition hover:text-ink"
          >
            {store.phone}
          </a>
        )}
      </div>
    </div>

    <!--
      Static, indexable copy of the menu. It ships zero JS and is what Google
      reads. The island below renders the interactive version and replaces it.
    -->
    <div class="static-menu">
      {catalog.sections.map((section) => (
        <section>
          <h2>{section.title}</h2>
          <ul>
            {section.products.map((product) => (
              <li>
                <h3>{product.title}</h3>
                {product.description && <p>{product.description}</p>}
                <span class="price">{money(product.price_cents, store.currency)}</span>
              </li>
            ))}
          </ul>
        </section>
      ))}
    </div>

    <OrderIsland client:load store={store} catalog={catalog} siteUrl={siteUrl} />
  </main>

  <style>
    /* The static crawlable menu only — the island replaces it on mount. */
    .static-menu { max-width: 1180px; margin: 0 auto; padding: 24px 22px 64px; }
    .static-menu ul { list-style: none; padding: 0; margin: 0; }
    .static-menu li { border-bottom: 1px solid var(--line); padding: 8px 0; }
    .static-menu h3 { margin: 0; font-size: 14px; font-weight: 600; text-transform: uppercase; }
    .static-menu p { margin: 2px 0; color: var(--muted); }
    .static-menu[hidden] { display: none; }
  </style>
</Base>
