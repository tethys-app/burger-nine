---
import Brand from '../layouts/Brand.astro'
import Top from '../components/landing/Top.astro'
import Bottom from '../components/landing/Bottom.astro'
import StoreMap from '../components/StoreMap.astro'
import { getBrand } from '../lib/api'
import { byDepartment, cityOf, deptLabel } from '../lib/stores'

const brand = await getBrand()
const groups = byDepartment(brand.stores)
const count = brand.stores.length
const deptCount = groups.length
---

<Brand
  title={`${brand.name} — T'es à un croc du kiff`}
  description={`Smash burgers, tacos, bowls & sandwichs. ${count} restaurant${count > 1 ? 's' : ''} en Auvergne-Rhône-Alpes.`}
  canonical={brand.siteUrl ?? undefined}
>
  <Top storeCount={count} />

  {/* Connected stores, from GET /v1/brands/{brand}. The POC hardcoded 16 cities
      as inert divs; every card here is a real store and links to its menu. */}
  <section class="sec restos-sec" id="restos">
    <div class="wrap">
      <div class="sec-head rv">
        <div>
          <div class="overline">04 · Nos restaurants</div>
          <h2>
            {count} spot{count > 1 ? 's' : ''},<br />
            {deptCount} département{deptCount > 1 ? 's' : ''}
          </h2>
        </div>
        <p class="side">
          {groups.map((g) => g.name ?? g.code).join(', ')} — et la famille s'agrandit.
        </p>
      </div>

      <div class="map-wrap rv">
        <div class="map-topline">
          <span class="map-eyebrow"><i></i> Carte des restaurants</span>
          <span class="map-help">Survole un point pour voir le restaurant</span>
        </div>
        <StoreMap stores={brand.stores} />
      </div>

      <div class="resto-grid rv">
        {brand.stores.map((store, index) => (
          <a class="resto" href={`/${store.slug}`}>
            <span class="resto-number">{String(index + 1).padStart(2, '0')}</span>
            <span class="dep">{deptLabel(store)}</span>
            <span class="city">{cityOf(store)}</span>
            <span class="note">Choisir ce restaurant <b aria-hidden="true">→</b></span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <Bottom />
</Brand>

<style>
  .restos-sec { background: linear-gradient(180deg, #1e0b1a 0%, #170915 100%); }
  .map-wrap {
    background: radial-gradient(circle at 50% 0%, rgba(255, 45, 158, 0.1), transparent 42%), #160a17;
    border: 1px solid rgba(255, 255, 255, 0.15);
    border-radius: 26px;
    padding: 18px 22px 24px;
    margin-bottom: 22px;
    box-shadow: 0 24px 60px rgba(0, 0, 0, 0.2);
  }
  .map-topline {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    padding: 2px 4px 14px;
    font-size: 12px;
    color: var(--muted);
  }
  .map-eyebrow { color: #fff; font-weight: 800; letter-spacing: .12em; text-transform: uppercase; }
  .map-eyebrow i { display: inline-block; width: 8px; height: 8px; margin-right: 8px; border-radius: 50%; background: var(--pink); box-shadow: 0 0 0 5px rgba(255, 45, 158, .14); }
  .map-help { font-size: 11px; }
  @media (max-width: 640px) {
    .map-wrap { padding: 14px 12px 16px; border-radius: 18px; }
    .map-topline { padding: 2px 5px 10px; }
    .map-help { display: none; }
  }

  /* The POC's resto cards were inert divs; they are links now. */
  a.resto { text-decoration: none; color: inherit; }
  a.resto .note { color: var(--pink); font-weight: 600; }
  .resto { position: relative; }
  .resto-number { position: absolute; top: 16px; right: 17px; color: rgba(255,255,255,.24); font-family: var(--display); font-size: 15px; font-weight: 800; }
  .resto .note b { display: inline-block; margin-left: 3px; transition: transform .2s; }
  .resto:hover .note b { transform: translateX(4px); }

</style>
