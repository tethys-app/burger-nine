---
import Brand from '../layouts/Brand.astro'
import Top from '../components/landing/Top.astro'
import Bottom from '../components/landing/Bottom.astro'
import StoreMap from '../components/StoreMap.astro'
import { getBrand } from '../lib/api'
import { cityOf, deptLabel, type Located } from '../lib/stores'
import { fr as t } from '../i18n/fr'

const brand = await getBrand()

// Every B9 / Burger Nine spot, connected or not. The POC hardcoded these 16
// cities as inert divs; the two live in brand.stores link to a real menu,
// the rest show as upcoming so the map and grid read as the whole chain.
const ALL_LOCATIONS: { slug: string; city: string; zipcode: string }[] = [
  { slug: 'b9-lyon-7', city: 'Lyon 7ᵉ', zipcode: '69007' },
  { slug: 'b9-tassin', city: 'Tassin-la-Demi-Lune', zipcode: '69160' },
  { slug: 'b9-vaugneray', city: 'Vaugneray', zipcode: '69670' },
  { slug: 'b9-mornant', city: 'Mornant', zipcode: '69440' },
  { slug: 'burger-nine-condrieu', city: 'Condrieu', zipcode: '69420' },
  { slug: 'b9-sainte-colombe', city: 'Sainte-Colombe', zipcode: '69560' },
  { slug: 'burger-nine-roussillon', city: 'Roussillon', zipcode: '38150' },
  { slug: 'b9-beaurepaire', city: 'Beaurepaire', zipcode: '38270' },
  { slug: 'b9-saint-jean-de-bournay', city: 'Saint-Jean-de-Bournay', zipcode: '38300' },
  { slug: 'b9-nine-la-cote', city: 'La Côte-Saint-André', zipcode: '38260' },
  { slug: 'b9-le-pont-de-beauvoisin', city: 'Le Pont-de-Beauvoisin', zipcode: '38480' },
  { slug: 'burger-nine-gex', city: 'Gex', zipcode: '01170' },
  { slug: 'b9-ferney-voltaire', city: 'Ferney-Voltaire', zipcode: '01210' },
  { slug: 'burger-nine-annonay', city: 'Annonay', zipcode: '07100' },
  { slug: 'b9-saint-vallier', city: 'Saint-Vallier', zipcode: '26240' },
  { slug: 'b9-tain-l-hermitage', city: "Tain-l'Hermitage", zipcode: '26600' },
]

const connected = new Map(brand.stores.map((s) => [s.slug, s]))
const liveSlugs = new Set(brand.stores.map((s) => s.slug))

const allStores: Located[] = ALL_LOCATIONS.map((loc) => {
  const live = connected.get(loc.slug)
  if (live) return live
  return {
    slug: loc.slug,
    name: `Burger Nine ${loc.city}`,
    address: { street: null, zipcode: loc.zipcode, city: loc.city, country: 'FR', latitude: null, longitude: null },
  }
})

const count = allStores.length
---

<Brand
  title={`${brand.name} — ${t.brand.homeTitleSuffix}`}
  description={`Smash burgers, tacos, bowls & sandwichs. ${count} restaurant${count > 1 ? 's' : ''} en Auvergne-Rhône-Alpes.`}
  canonical={brand.siteUrl ?? undefined}
>
  <Top storeCount={count} />

  {/* Every B9 / Burger Nine spot. The two connected to GET /v1/brands/{brand}
      link to a real menu; the rest of the chain shows as "bientôt". */}
  <section class="sec restos-sec" id="restos">
    <div class="wrap">
      <div class="sec-head rv">
        <div>
          <div class="overline">{t.restos.overline}</div>
          <h2>{t.restos.title}</h2>
        </div>
      </div>

      <div class="map-wrap rv">
        <div class="map-topline">
          <span class="map-help">{t.restos.mapHelp}</span>
        </div>
        <StoreMap stores={allStores} liveSlugs={liveSlugs} />
      </div>

      <div class="resto-grid rv">
        {allStores.map((store) => {
          const isLive = liveSlugs.has(store.slug)
          const Tag = isLive ? 'a' : 'div'
          return (
            <Tag class:list={['resto', { soon: !isLive }]} {...(isLive ? { href: `/${store.slug}` } : {})}>
              <span class="dep">{deptLabel(store)}</span>
              <span class="city">{cityOf(store)}</span>
            </Tag>
          )
        })}
      </div>
    </div>
  </section>

  <Bottom home />
</Brand>

<style>
  .restos-sec { background: linear-gradient(180deg, #1e0b1a 0%, #170915 100%); }
  .map-wrap {
    background: radial-gradient(circle at 50% 0%, rgba(255, 45, 158, 0.1), transparent 42%), #160a17;
    border: 1px solid rgba(255, 255, 255, 0.15);
    border-radius: 26px;
    padding: 18px 22px 24px;
    margin-bottom: 22px;
    box-shadow: 0 24px 60px rgba(0, 0, 0, 0.2);
  }
  .map-topline {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    gap: 16px;
    padding: 2px 4px 14px;
    font-size: 12px;
    color: var(--muted);
  }
  .map-help { font-size: 11px; }
  @media (max-width: 640px) {
    .map-wrap { padding: 14px 12px 16px; border-radius: 18px; }
    .map-topline { padding: 2px 5px 10px; }
    .map-help { display: none; }
  }

  /* Live stores are links; the rest render identically so the chain reads as fully open. */
  a.resto { text-decoration: none; color: inherit; }
  .resto { position: relative; }

</style>
