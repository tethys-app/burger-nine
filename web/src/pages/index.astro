---
import Brand from '../layouts/Brand.astro'
import Top from '../components/landing/Top.astro'
import Bottom from '../components/landing/Bottom.astro'
import { getBrand } from '../lib/api'
import { byDepartment, cityOf, deptLabel } from '../lib/stores'

const brand = await getBrand()
const groups = byDepartment(brand.stores)
const count = brand.stores.length
const deptCount = groups.length
---

<Brand
  title={`${brand.name} — T'es à un croc du kiff`}
  description={`Smash burgers, tacos, bowls & sandwichs. ${count} restaurant${count > 1 ? 's' : ''} en Auvergne-Rhône-Alpes.`}
  canonical={brand.siteUrl ?? undefined}
>
  <Top />

  {/* Connected stores, from GET /v1/brands/{brand}. The POC hardcoded 16 cities
      as inert divs; every card here is a real store and links to its menu. */}
  <section class="sec" id="restos">
    <div class="wrap">
      <div class="sec-head rv">
        <div>
          <div class="overline">04 · Nos restaurants</div>
          <h2>
            {count} spot{count > 1 ? 's' : ''},<br />
            {deptCount} département{deptCount > 1 ? 's' : ''}
          </h2>
        </div>
        <p class="side">
          {groups.map((g) => g.name ?? g.code).join(', ')} — et la famille s'agrandit.
        </p>
      </div>

      <div class="resto-grid rv">
        {brand.stores.map((store) => (
          <a class="resto" href={`/${store.slug}`}>
            <span class="dep">{deptLabel(store)}</span>
            <span class="city">{cityOf(store)}</span>
            <span class="note">Commander →</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  {/* One entry point per connected store. The POC said "la commande en ligne
      arrive bientôt" — it is here, so that placeholder is gone. */}
  <section class="order" id="commander">
    <div class="wrap">
      <div class="order-grid">
        <div class="rv">
          <div class="overline">06 · Commander</div>
          <h2 class="order-title">Envie du <span class="pk">kiff</span> ?</h2>
          <p class="lead">
            Sur place, à emporter ou en livraison — choisis ton resto et c'est parti.
          </p>
          <div class="order-list">
            {brand.stores.map((store) => (
              <a class="order-store" href={`/${store.slug}`}>
                <span class="os-city">{cityOf(store)}</span>
                <span class="os-addr">
                  {store.address?.street}{store.address?.zipcode ? `, ${store.address.zipcode}` : ''}
                </span>
                <svg viewBox="0 0 10 12" fill="currentColor" aria-hidden="true">
                  <path d="M0 0l10 6-10 6z"></path>
                </svg>
              </a>
            ))}
          </div>
        </div>
      </div>
    </div>
  </section>

  <Bottom />
</Brand>

<style>
  /* The POC's resto cards were inert divs; they are links now. */
  a.resto { text-decoration: none; color: inherit; }
  a.resto .note { color: var(--pink); font-weight: 600; }

  .order-title {
    font-family: var(--display);
    font-weight: 800;
    font-size: clamp(34px, 4.6vw, 56px);
    line-height: 1.02;
    text-transform: uppercase;
    margin-bottom: 18px;
  }
  .order-list { display: flex; flex-direction: column; gap: 10px; margin-top: 22px; }
  .order-store {
    display: grid;
    grid-template-columns: 1fr auto;
    grid-template-areas: 'city arrow' 'addr arrow';
    align-items: center;
    gap: 2px 16px;
    padding: 16px 20px;
    background: var(--panel);
    border: 1px solid var(--line);
    border-radius: 16px;
    color: inherit;
    text-decoration: none;
    transition: transform 0.25s, border-color 0.25s;
  }
  .order-store:hover { transform: translateY(-2px); border-color: var(--pink); }
  .os-city {
    grid-area: city;
    font-family: var(--display);
    font-weight: 800;
    font-size: 19px;
    text-transform: uppercase;
    letter-spacing: 0.02em;
  }
  .os-addr { grid-area: addr; font-size: 12.5px; color: var(--muted); }
  .order-store svg { grid-area: arrow; width: 10px; color: var(--pink); }
</style>
