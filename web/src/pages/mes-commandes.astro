---
import Base from '../layouts/Base.astro'
import Nav from '../components/Nav.astro'
import MyOrders from '../components/MyOrders.tsx'

// Everything here is per-customer and behind an SMS code, so there is nothing
// to prerender and nothing for a crawler to index.
---

<Base title="Mes commandes">
  <meta slot="head" name="robots" content="noindex" />
  <Nav />
  <main>
    <MyOrders client:load />
  </main>

  <style>
    main { max-width: 620px; margin: 0 auto; padding: 130px 22px 90px; }

    main :global(h1) {
      font-family: var(--display);
      font-weight: 800;
      font-size: clamp(24px, 3.4vw, 34px);
      text-transform: uppercase;
      line-height: 1.05;
      margin: 0 0 6px;
    }
    main :global(.muted) { color: var(--muted); margin: 0 0 24px; }
    main :global(.error) { color: var(--pink); margin: 0; }

    main :global(.login) { display: grid; gap: 14px; }
    main :global(.login input) {
      font: inherit;
      font-size: 17px; /* < 16px makes iOS zoom on focus */
      padding: 14px 16px;
      color: var(--txt);
      background: var(--panel);
      border: 1px solid var(--line);
      border-radius: 14px;
    }
    main :global(.login button) { justify-content: center; }
    main :global(.linky) {
      background: none; border: 0; padding: 0;
      color: var(--muted); font: inherit; text-decoration: underline; cursor: pointer;
    }

    main :global(.history header) {
      display: flex; align-items: baseline; justify-content: space-between; gap: 16px;
      margin-bottom: 24px;
    }
    main :global(.history ol) { list-style: none; padding: 0; margin: 0; display: grid; gap: 12px; }
    main :global(.history a) {
      display: grid;
      grid-template-columns: 1fr auto;
      gap: 2px 16px;
      padding: 16px 18px;
      color: inherit;
      text-decoration: none;
      background: var(--panel);
      border: 1px solid var(--line);
      border-radius: 18px;
    }
    main :global(.history .when) { color: var(--muted); font-size: 13px; }
    main :global(.history .sum) {
      grid-row: 1 / 3; grid-column: 2;
      align-self: center;
      font-family: var(--display); font-weight: 800; font-size: 18px;
    }
    main :global(.history .what) { grid-column: 1; }
    main :global(.history .where),
    main :global(.history .state) { grid-column: 1; color: var(--muted); font-size: 13px; }
  </style>
</Base>
