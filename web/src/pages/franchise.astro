---
import Brand from '../layouts/Brand.astro'
import Nav from '../components/Nav.astro'
import Bottom from '../components/landing/Bottom.astro'
---

<Brand
  title="Franchise — Burger Nine"
  description="Deviens titulaire d'un Burger Nine : droit d'entrée, formation, cash back et accompagnement pour ouvrir ton spot."
>
  <Nav />

  <section class="sec" id="franchise-hero" style="padding-top: 140px">
    <div class="wrap">
      <div class="overline">Franchise</div>
      <h1
        style="
          font-family: var(--display);
          font-weight: 800;
          font-size: clamp(36px, 5.6vw, 68px);
          line-height: 1.02;
          text-transform: uppercase;
          max-width: 820px;
          margin-bottom: 46px;
        "
      >
        On cherche des porteurs de projet
        <br />
        <span
          style="
            background: linear-gradient(90deg, var(--pink-deep), var(--yellow) 55%, var(--violet));
            -webkit-background-clip: text;
            background-clip: text;
            -webkit-text-fill-color: transparent;
          "
        >prêts à ouvrir leur Burger Nine.</span>
      </h1>

      <div class="franchise-grid rv" style="max-width: 1040px; margin: 0 auto">
        <div class="fr-visual" style="justify-self: stretch; width: 100%;">
          <figure class="fr-card">
            <img
              src="/assets/6c07fc3d54cb76ac.jpg"
              alt="Devanture d'un restaurant Burger Nine de nuit"
            />
          </figure>
        </div>

        <div>
          <h2
            style="
              font-family: var(--display);
              font-weight: 800;
              font-size: clamp(26px, 3vw, 36px);
              line-height: 1.05;
              text-transform: uppercase;
              margin-bottom: 26px;
            "
          >
            Ce qu'on met sur la table
          </h2>
          <div class="feat">
            <div class="feat-item">
              <div class="feat-ico">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M12 3l-2.4 3.8H6.2C4.8 10.8 4 14.4 6 17.3 7.4 19.3 9.8 21 12 21s4.6-1.7 6-3.7c2-2.9 1.2-6.5-.2-10.5h-3.4L12 3z" />
                  <path d="M9.8 12.3c.4-.6 1.2-1 2.2-1s1.8.4 2.2 1M9.8 14.3c.4.6 1.2 1 2.2 1s1.8-.4 2.2-1" />
                </svg>
              </div>
              <div><b>15 000 € droit d'entrée</b></div>
            </div>
            <div class="feat-item">
              <div class="feat-ico">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M22 10L12 5 2 10l10 5 10-5z" />
                  <path d="M6 12v5c0 1.5 2.5 3 6 3s6-1.5 6-3v-5" />
                </svg>
              </div>
              <div><b>3 000 € formation</b></div>
            </div>
            <div class="feat-item">
              <div class="feat-ico">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                  <polyline points="23 6 13.5 15.5 8.5 10.5 1 18" />
                  <polyline points="17 6 23 6 23 12" />
                </svg>
              </div>
              <div><b>18 mois cash back</b></div>
            </div>
            <div class="feat-item">
              <div class="feat-ico">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z" />
                  <circle cx="12" cy="10" r="3" />
                </svg>
              </div>
              <div><b>Bientôt 20 spots</b></div>
            </div>
            <div class="feat-item">
              <div class="feat-ico">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                  <rect x="3" y="4" width="18" height="17" rx="2" />
                  <path d="M3 9h18M8 2v4M16 2v4" />
                </svg>
              </div>
              <div><b>Forfait fixe mensuel</b></div>
            </div>
            <div class="feat-item">
              <div class="feat-ico">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                  <polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2" />
                </svg>
              </div>
              <div><b>Le réseau grandit — embarque avant tout le monde</b></div>
            </div>
          </div>
          <div class="cta-row" style="display: flex; gap: 16px; flex-wrap: wrap; margin-top: 36px">
            <a
              href="https://www.instagram.com/b9.burgernine/"
              target="_blank"
              rel="noopener"
              class="btn bn-cta gold"
            >
              Candidater sur Instagram
              <svg viewBox="0 0 10 12" fill="currentColor" aria-hidden="true">
                <path d="M0 0l10 6-10 6z" />
              </svg>
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <Bottom />
</Brand>
