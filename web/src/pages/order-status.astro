---
import Base from '../layouts/Base.astro'
import OrderStatus from '../components/OrderStatus.tsx'

// A static page that reads ?id=&token= at runtime. Order ids do not exist at
// build time, so this cannot be a prerendered dynamic route — which is exactly
// why checkout's returnUrl points here.
---

<Base title="Votre commande">
  <meta slot="head" name="robots" content="noindex" />
  <main>
    <OrderStatus client:load />
  </main>

  <style>
    main { max-width: 560px; margin: 0 auto; padding: 48px 16px; }
    :global(.status h1) { font-size: 18px; margin: 0 0 4px; }
    :global(.status .store) { color: var(--muted); margin: 0 0 24px; }
    :global(.status ol) { list-style: none; padding: 0; margin: 0; }
    :global(.status li) {
      display: grid; grid-template-columns: 1fr auto;
      border-bottom: 1px solid var(--line); padding: 8px 0;
    }
    :global(.status .options) { color: var(--muted); grid-column: 1 / -1; }
    :global(.status .total) { text-align: right; margin-top: 16px; }
  </style>
</Base>
