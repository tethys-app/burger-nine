---
// Static SVG map of the connected stores. No mapping library and no tiles:
// the department outlines are 20kB of build-time JSON, so this ships as plain
// markup that inherits the brand palette and costs no runtime JS.
//
// The viewBox is fitted to the stores' own bounding box, so it stays centred
// on wherever the brand actually is rather than a hardcoded region.
import departements from '../lib/departements.json'
import { coordsFor, cityOf, type Located } from '../lib/stores'

interface Props {
  stores: Located[]
  /** Slugs with a real menu page. Others render as an upcoming pin, not a link. */
  liveSlugs?: Set<string>
}
const { stores, liveSlugs } = Astro.props

const located = stores.flatMap((store) => {
  const point = coordsFor(store)
  return point ? [{ store, ...point }] : []
})

// Web Mercator. At this latitude ignoring it would visibly squash the north.
const mercY = (lat: number) => Math.log(Math.tan(Math.PI / 4 + (lat * Math.PI) / 180 / 2))

const lons = located.map((p) => p.lon)
const lats = located.map((p) => p.lat)
// Padding in degrees so the outermost pins are never flush against the edge.
// The stores are spread taller than they are wide, which projects to an
// awkwardly tall panel — so widen the frame (keeping it centred on the stores)
// until it is landscape, rather than distorting the projection.
const padY = 0.28
const minLat = Math.min(...lats) - padY
const maxLat = Math.max(...lats) + padY

const midLat = (minLat + maxLat) / 2
const midLon = (Math.min(...lons) + Math.max(...lons)) / 2
// How many degrees of longitude the latitude span covers on screen here; widen
// to ~1.7x that for a landscape frame, but never narrower than the stores need.
const latSpanAsLon = (maxLat - minLat) / Math.cos((midLat * Math.PI) / 180)
const halfLon = Math.max(Math.max(...lons) - midLon + 0.28, (latSpanAsLon * 1.7) / 2)
const minLon = midLon - halfLon
const maxLon = midLon + halfLon

const W = 1000
// Both spans in radians: mercY is radians, so longitude has to match or the
// aspect ratio is out by a factor of 57.
const spanX = ((maxLon - minLon) * Math.PI) / 180
const spanY = mercY(maxLat) - mercY(minLat)
const H = Math.round((W * spanY) / spanX)

const x = (lon: number) => (((lon - minLon) * Math.PI) / 180 / spanX) * W
const y = (lat: number) => H - ((mercY(lat) - mercY(minLat)) / spanY) * H

const path = (poly: number[][]) =>
  poly.map(([lon, lat], i) => `${i ? 'L' : 'M'}${x(lon).toFixed(1)} ${y(lat).toFixed(1)}`).join('') + 'Z'

// Departments the brand is actually in are filled brighter than their neighbours.
const active = new Set(located.map((p) => p.store.address?.zipcode?.slice(0, 2)))
---

<figure class="map">
  <div class="map-badge">{located.length} restaurants</div>
  <svg viewBox={`0 0 ${W} ${H}`} role="img" aria-label={`Carte de nos ${located.length} restaurants`}>
    <defs>
      <pattern id="map-grid" width="36" height="36" patternUnits="userSpaceOnUse">
        <path d="M 36 0 L 0 0 0 36" fill="none" stroke="rgba(255,255,255,.07)" stroke-width="1" />
      </pattern>
      <radialGradient id="map-glow" cx="50%" cy="15%" r="85%">
        <stop offset="0%" stop-color="#ff2d9e" stop-opacity=".22" />
        <stop offset="55%" stop-color="#ffb35e" stop-opacity=".06" />
        <stop offset="100%" stop-color="#ff2d9e" stop-opacity="0" />
      </radialGradient>
      <linearGradient id="dept-on-stroke" x1="0" y1="0" x2="1" y2="1">
        <stop offset="0%" stop-color="#ff5cae" />
        <stop offset="100%" stop-color="#ffb35e" />
      </linearGradient>
      <filter id="pin-shadow" x="-60%" y="-60%" width="220%" height="220%">
        <feDropShadow dx="0" dy="2" stdDeviation="3" flood-color="#000" flood-opacity=".45" />
      </filter>
    </defs>
    <rect class="map-field" width={W} height={H} rx="18" />
    <rect class="map-glow" width={W} height={H} rx="18" fill="url(#map-glow)" />
    {departements.map((dept) => (
      <g class:list={['dept', { on: active.has(dept.code) }]}>
        {dept.polys.map((poly) => <path d={path(poly)} />)}
      </g>
    ))}

    <g class="pins">
      {located.map(({ store, lat, lon }, i) => {
        const isLive = liveSlugs ? liveSlugs.has(store.slug) : true
        const Tag = isLive ? 'a' : 'g'
        return (
          <Tag class="pin" {...(isLive ? { href: `/${store.slug}` } : {})}>
            <title>{cityOf(store)}</title>
            <circle class="pulse" cx={x(lon)} cy={y(lat)} r="14" style={`animation-delay: ${(i % 6) * 0.4}s`} />
            <circle class="ring" cx={x(lon)} cy={y(lat)} r="14" />
            <circle class="halo" cx={x(lon)} cy={y(lat)} r="17" />
            <circle class="dot" cx={x(lon)} cy={y(lat)} r="7" filter="url(#pin-shadow)" />
            <text x={x(lon)} y={y(lat) - 20}>{cityOf(store)}</text>
          </Tag>
        )
      })}
    </g>
  </svg>
</figure>

<script>
  // SVG paints in document order and has no z-index, so a hovered pin's label
  // would be covered by any pin declared after it. Move it to the end.
  for (const group of document.querySelectorAll<SVGGElement>('.map .pins')) {
    for (const pin of group.querySelectorAll<SVGAElement>('.pin')) {
      const raise = () => group.appendChild(pin)
      pin.addEventListener('mouseenter', raise)
      pin.addEventListener('focus', raise)
    }
  }
</script>

<style>
  .map { position: relative; margin: 0; overflow: hidden; border-radius: 16px; }
  .map svg { width: 100%; height: auto; display: block; overflow: visible; }
  .map-field { fill: url(#map-grid); }
  .map-glow { pointer-events: none; }

  .map-badge {
    position: absolute;
    top: 14px;
    left: 14px;
    z-index: 2;
    font-family: var(--display);
    font-weight: 800;
    font-size: 11px;
    letter-spacing: .08em;
    text-transform: uppercase;
    color: #fff;
    background: rgba(10, 3, 8, 0.55);
    border: 1px solid rgba(255, 255, 255, 0.18);
    backdrop-filter: blur(6px);
    padding: 7px 12px;
    border-radius: 999px;
  }

  .dept path {
    fill: rgba(255, 255, 255, 0.05);
    stroke: rgba(255,255,255,.2);
    stroke-width: 1.5;
    stroke-linejoin: round;
    transition: fill .3s;
  }
  .dept.on path {
    fill: rgba(255, 45, 158, 0.14);
    stroke: url(#dept-on-stroke);
    stroke-width: 1.8;
  }

  .pin { cursor: pointer; }
  .pin .ring { fill: none; stroke: rgba(255,255,255,.55); stroke-width: 1; opacity: .55; transition: opacity .25s, r .25s; }
  .pin .halo { fill: var(--pink); opacity: 0.18; transition: opacity 0.25s, r 0.25s; }
  .pin .pulse {
    fill: none;
    stroke: var(--pink);
    stroke-width: 1.5;
    opacity: 0;
    transform-origin: center;
    transform-box: fill-box;
    animation: pin-pulse 2.6s ease-out infinite;
  }
  .pin .dot {
    fill: var(--pink);
    stroke: #fff;
    stroke-width: 2;
    transition: r 0.25s;
  }
  /* The stores cluster tightly around Lyon, so 16 permanent labels overlap
     into mush. The dots carry the geography; the name appears on hover, and
     the card grid below is the readable list of every city. */
  .pin > text {
    fill: #fff;
    font-family: var(--display);
    font-weight: 800;
    font-size: 20px;
    text-anchor: middle;
    text-transform: uppercase;
    paint-order: stroke;
    stroke: var(--bg);
    stroke-width: 6px;
    stroke-linejoin: round;
    pointer-events: none;
    opacity: 0;
    transition: opacity 0.18s;
  }
  .pin:hover .halo, .pin:focus-visible .halo { opacity: 0.48; }
  .pin:hover .ring, .pin:focus-visible .ring { opacity: 1; r: 18; }
  .pin:hover .dot, .pin:focus-visible .dot { r: 9; }
  .pin:hover text, .pin:focus-visible text { opacity: 1; }

  @keyframes pin-pulse {
    0% { opacity: .55; r: 7; }
    100% { opacity: 0; r: 22; }
  }

  @media (prefers-reduced-motion: reduce) {
    .pin .halo, .pin .ring, .pin .dot, .pin text { transition: none; }
    .pin .pulse { animation: none; opacity: 0; }
  }
</style>
