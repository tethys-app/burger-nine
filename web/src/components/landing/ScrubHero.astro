---
// Scroll-scrubbed hero. The video is pinned while the page scrolls `screens`
// viewports' worth; that distance maps linearly onto the clip's duration, so
// reaching the end of the scrub range = the last frame.
//
// It opens as a copy of the real homepage hero — headline left, CTA at the
// bottom — because the clip's first frame and the still it replaces are nearly
// the same shot. Scrolling then dissolves the copy until only the button is
// left over the storefront.
//
// The clip is re-encoded all-keyframe (`-g 1`) in public/assets/video. A normal
// GOP makes every `currentTime` seek decode from the last keyframe, which reads
// as stutter — the encode is what makes this smooth, not the JS.
import { fr as t } from '../../i18n/fr'
import BnineButton from '../theme/BnineButton.astro'

interface Props {
  /** Screens of scrolling that play the clip start to end. Higher = the video
      advances more slowly per notch of scroll. */
  screens?: number
  /** Cities to run through the tail. Once the clip has finished, this list
      scrolls at true scroll speed over the last frame — the pin stays, but
      something tracks the wheel 1:1, so it reads as a backdrop rather than as
      being stuck. Empty = no tail. */
  tail?: string[]
}
const { screens = 4, tail = [] } = Astro.props
---

<section class="scrub" id="top" style={`--screens:${screens}`}>
  <div class="scrub-stage">
    <video
      id="scrubVideo"
      src="/assets/video/hero-scrub-v2.mp4"
      poster="/assets/video/hero-scrub-v2-poster.jpg"
      muted
      playsinline
      preload="auto"
      aria-hidden="true"></video>
    <div class="scrub-vignette" aria-hidden="true"></div>

    <!-- One left block, set against the billboard in the plate rather than
         pinned to the frame edges. -->
    <div class="scrub-frame">
      <div class="scrub-block">
        <h1 data-fade="0">
          {t.hero.headlineLead}<br />{t.hero.headlineMid}<span class="hl-frappe">{t.hero.headlineHighlight}</span><br
          />{t.hero.headlineTrail}.
        </h1>
        <p class="scrub-tagline" data-fade="1">{t.hero.headlineLines[0]} {t.hero.headlineLines[1]}</p>

        <div class="scrub-act" data-fade="2">
          <BnineButton href="#restos" arrow>{t.hero.cta}</BnineButton>
          <p class="scrub-micro"><a href="#franchise">{t.hero.micro}</a></p>
        </div>
      </div>
    </div>

    <!-- Runs once the clip is done, at true scroll speed. The frame is still,
         but this tracks the wheel 1:1, so the pin no longer reads as a trap.
         aria-hidden: the same cities are a real list in #restos below. -->
    {tail.length > 0 && (
      <div class="scrub-tail" aria-hidden="true">
        <ul>
          {tail.map((city) => (
            <li>{city}</li>
          ))}
        </ul>
      </div>
    )}

    <!-- The payoff CTA. A separate element from the intro one so it can rise
         from the bottom, centred, once the storefront is the whole shot —
         sliding the intro button down the left edge read as a leftover. -->
    <div class="scrub-payoff" aria-hidden="true">
      <BnineButton href="#restos" arrow>{t.hero.cta}</BnineButton>
    </div>

    <div class="scrub-hint" aria-hidden="true"><span></span></div>
  </div>
</section>

<style>
  /* The tall element creates the scroll distance; the stage inside sticks, so
     the video holds still while that distance is consumed. */
  .scrub {
    position: relative;
    /* --release fades the extra scroll distance away: at 0 the full pinned
       track, at 1 a single ordinary screen. */
    height: calc((1 + var(--screens) * (1 - var(--release, 0))) * 100svh);
    background: var(--ink-900);
  }
  .scrub-stage {
    position: sticky;
    top: 0;
    height: 100svh;
    overflow: hidden;
    isolation: isolate;
  }
  .scrub-stage video {
    position: absolute;
    /* Pulled up so the storefront sits higher in the frame. Grown by the same
       amount at the bottom, otherwise the shift leaves a strip of background
       under the video. */
    inset: calc(-1 * var(--video-shift, 70px)) 0 0;
    width: 100%;
    height: calc(100% + var(--video-shift, 70px));
    object-fit: cover;
    object-position: 50% 38%;
  }
  /* Mirrors .hero::after — the copy needs the same scrim to stay legible over
     the first frame as it does over the still. */
  .scrub-vignette {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      180deg,
      rgba(15, 2, 9, 0.62) 0%,
      rgba(15, 2, 9, 0.32) 22%,
      rgba(15, 2, 9, 0.1) 40%,
      rgba(15, 2, 9, 0.12) 66%,
      rgba(15, 2, 9, 0.55) 100%
    );
    /* Fades out with the copy: once the storefront is the subject, the scrim
       is just haze over it. */
    opacity: var(--scrim, 1);
  }

  /* Left-aligned block, set against the billboard: centred vertically rather
     than pinned top-and-bottom, and sitting in the left third of the plate so
     it reads as part of the shot instead of an overlay on it. */
  .scrub-frame {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: flex-start;
    text-align: left;
    padding: calc(76px + 18px) 20px calc(28px + env(safe-area-inset-bottom, 0px));
  }
  @media (min-width: 768px) {
    .scrub-frame {
      /* Further left than the body column: the billboard occupies the right
         half of the frame, so the copy claims the left. */
      padding-left: max(28px, calc(50vw - 600px));
      padding-right: 20px;
      /* Nudged below centre so the headline sits across the billboard's
         middle, not above it. */
      padding-top: calc(76px + 18px + 7vh);
    }
  }

  .scrub-block {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 18px;
    max-width: min(620px, 52vw);
  }
  @media (max-width: 767px) {
    .scrub-block { max-width: none; }
  }

  .scrub-frame h1 {
    margin: 0;
    font-family: var(--display);
    font-weight: 800;
    font-size: clamp(42px, 5.6vw, 78px);
    line-height: 0.92;
    letter-spacing: -0.01em;
    text-transform: uppercase;
    color: #fff;
    text-shadow: 0 1px 2px rgba(10, 2, 6, 0.9), 0 3px 10px rgba(10, 2, 6, 0.75), 0 12px 30px rgba(10, 2, 6, 0.5);
  }
  .scrub-tagline {
    margin: 0;
    font-family: var(--display2);
    font-size: clamp(14.5px, 1.5vw, 20px);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.86);
  }
  .scrub-micro {
    margin: 0;
    font-size: 11.5px;
    letter-spacing: 0.04em;
    color: rgba(255, 255, 255, 0.82);
  }
  .scrub-micro a {
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  /* Everything but the button dissolves as the clip plays. */
  .scrub-frame [data-fade] {
    opacity: var(--o, 1);
    transform: translateY(calc((1 - var(--o, 1)) * -18px));
    will-change: opacity, transform;
  }

  .scrub-act {
    display: flex;
    flex-direction: column;
    align-items: stretch;
    gap: 12px;
    width: 100%;
    margin-top: 6px;
  }
  .scrub-act :global(.bn-cta) {
    width: 100%;
    min-height: 60px;
    font-size: 18px;
  }
  @media (min-width: 768px) {
    /* Full-bleed is right on a phone; on desktop the button shouldn't span the
       whole reading column. */
    .scrub-act {
      align-items: flex-start;
      width: auto;
    }
    .scrub-act :global(.bn-cta) {
      width: auto;
      min-width: 300px;
      padding: 0 44px;
    }
  }

  /* Centred in the bottom half, rising into place. `--in` runs 0→1 over the
     back end of the scrub. */
  .scrub-payoff {
    position: absolute;
    left: 50%;
    top: var(--payoff-top, 80%);
    translate: -50% -50%;
    display: flex;
    justify-content: center;
    width: min(360px, calc(100% - 40px));
    opacity: var(--in, 0);
    transform: translateY(calc((1 - var(--in, 0)) * 90px));
    /* Unclickable until it is actually there — an invisible button over the
       storefront still takes the click. */
    pointer-events: var(--payoff-events, none);
    will-change: opacity, transform;
  }
  .scrub-payoff :global(.bn-cta) {
    width: 100%;
    min-height: 62px;
    font-size: 18px;
  }

  /* The tail. Translated in px straight from scroll delta — deliberately not
     eased, unlike the video: the whole point is that it moves exactly as fast
     as the wheel, which is what tells the hand it is not stuck. */
  .scrub-tail {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: flex-start;
    /* Left column, same gutter as the headline — the CTA owns the centre by
       the time this appears, so the cities take the side. */
    justify-content: flex-start;
    padding-left: 20px;
    overflow: hidden;
    opacity: var(--tail-in, 0);
    pointer-events: none;
  }
  @media (min-width: 768px) {
    .scrub-tail { padding-left: max(28px, calc(50vw - 600px)); }
  }
  /* The payoff CTA is centred and up to 360px wide; on a phone that spans
     nearly the full width. Shrink the scrolling region so the list runs above
     the button instead of through it — `bottom` clips it, the transform is
     untouched. */
  @media (max-width: 767px) {
    .scrub-tail { bottom: 38vh; }
    .scrub-tail li { font-size: clamp(18px, 6vw, 30px); }
  }
  .scrub-tail ul {
    margin: 0;
    padding: 0;
    list-style: none;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: clamp(8px, 1.4vh, 18px);
    translate: 0 var(--tail-y, 0px);
    /* Comes up already part-grown and settles to full size as it fades in, so
       it reads as arriving rather than being switched on. */
    scale: var(--tail-scale, 1);
    transform-origin: left center;
    will-change: transform, scale;
  }
  .scrub-tail li {
    font-family: var(--display);
    font-weight: 800;
    /* Smaller than the headline: this is a supporting list running past the
       button, not a second headline competing with it. */
    font-size: clamp(20px, 2.6vw, 38px);
    line-height: 1;
    letter-spacing: -0.01em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.9);
    white-space: nowrap;
    text-shadow: 0 1px 2px rgba(10, 2, 6, 0.9), 0 4px 16px rgba(10, 2, 6, 0.8);
  }

  .scrub-hint {
    position: absolute;
    left: 50%;
    bottom: 26px;
    translate: -50% 0;
    width: 26px;
    height: 42px;
    border: 2px solid rgb(255 255 255 / 0.4);
    border-radius: 14px;
    opacity: var(--hint, 0);
    pointer-events: none;
  }
  .scrub-hint span {
    position: absolute;
    left: 50%;
    top: 8px;
    translate: -50% 0;
    width: 3px;
    height: 7px;
    border-radius: 2px;
    background: var(--pink);
    animation: scrub-wheel 1.6s ease-in-out infinite;
  }
  @keyframes scrub-wheel {
    0%, 100% { transform: translateY(0); opacity: 1; }
    50% { transform: translateY(12px); opacity: 0.3; }
  }

  /* No pinning, no scrubbing: the clip is decorative, so the poster frame with
     the copy in its opening position says the same thing. */
  @media (prefers-reduced-motion: reduce) {
    .scrub { height: 100svh; }
    .scrub-frame [data-fade] { opacity: 1; transform: none; }
    .scrub-act { transform: none; }
    .scrub-hint span { animation: none; }
    /* No pin means no dead tail to fill. */
    .scrub-tail { display: none; }
  }
</style>

<script>
  const section = document.querySelector<HTMLElement>('.scrub')
  const stage = document.querySelector<HTMLElement>('.scrub-stage')
  const video = document.getElementById('scrubVideo') as HTMLVideoElement | null
  const fades = Array.from(document.querySelectorAll<HTMLElement>('.scrub-frame [data-fade]'))
  const payoff = document.querySelector<HTMLElement>('.scrub-payoff')
  const vignette = document.querySelector<HTMLElement>('.scrub-vignette')
  const hint = document.querySelector<HTMLElement>('.scrub-hint')
  const tail = document.querySelector<HTMLElement>('.scrub-tail')
  const tailList = document.querySelector<HTMLElement>('.scrub-tail ul')
  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches

  if (section && video && !reduceMotion) {
    // Every timing in one place, as fractions of the scrub — the dev panel
    // (?tune) mutates this object live, so nothing below may cache a value.
    const cfg = {
      screens: Number(section.style.getPropertyValue('--screens')) || 4,
      ease: 0.16,
      // How much of the pinned range the clip occupies. Below 1 the video
      // finishes early and the rest of the pin holds on the last frame — dead
      // air on its own, but that stretch is exactly what the tail fills, and a
      // still frame with a list moving over it at true scroll speed reads far
      // better than a video creeping frame by frame.
      span: 0.3,
      // Multiplier on the tail's travel. 1 = the list moves exactly as far as
      // the page scrolls, which is what makes it feel un-jacked; below 1 it
      // drags, above 1 it outruns the wheel.
      tailRate: 1,
      // Fraction of the *remaining* scroll (after `span`) spent fading the tail
      // in, so it does not pop the instant the clip ends.
      tailFade: 0.12,
      // 0 = fully pinned (classic scrub). 1 = the stage scrolls away at normal
      // page speed while it scrubs, so the video behaves like any other
      // element and the page never feels held.
      release: 0,
      videoShift: 70,
      payoffTop: 80,
      headOut: [0.1, 0.42],
      tagOut: [0.06, 0.3],
      actOut: [0.06, 0.3],
      // Fraction of the *remaining* scroll (after the clip ends) that the
      // button takes to arrive. Derived from `span` rather than absolute, so
      // there is never a stretch where the video has stopped and the button
      // has not started — that gap is what reads as scrolling into nothing.
      payoffRise: 0.18,
      scrimOut: [0.15, 0.6],
      scrimAmount: 0.55,
    }
    // Per-frame telemetry for the dev tuner's scopes. Written every paint,
    // read by whoever wants it; nothing here affects the animation.
    const telemetry = {
      t: 0, // ms
      dt: 0, // ms since last paint
      target: 0, // raw scroll progress 0..1
      current: 0, // eased progress the video is actually at
      lag: 0, // target - current, i.e. what `ease` is costing
      velocity: 0, // progress per second
      scrollY: 0,
      seekMs: 0, // last seek duration
      painting: false,
    }
    ;(window as any).__scrub = { cfg, section, telemetry, video }

    const OUT = () => [cfg.headOut, cfg.tagOut, cfg.actOut] as [number, number][]
    // The button starts the instant the last frame lands and finishes a short
    // way later; the list then owns everything after that. Computed rather
    // than configured so the three phases can never drift apart.
    const payoffWindow = () => {
      const a = clamp01(cfg.span)
      return [a, Math.min(a + (1 - a) * cfg.payoffRise, 1)] as [number, number]
    }
    const clamp01 = (n: number) => (n < 0 ? 0 : n > 1 ? 1 : n)
    const smooth = (n: number) => n * n * (3 - 2 * n)
    const fadeOut = (p: number, [a, b]: [number, number]) => 1 - smooth(clamp01((p - a) / (b - a)))

    let duration = 0
    let target = 0
    let current = 0
    let raf = 0

    const progress = () => {
      // The last screen of the section is the sticky stage itself, so the
      // scrubbable distance is the section height minus one viewport.
      const range = section.offsetHeight - window.innerHeight
      // Fully released there is no track inside the hero, so the clip is
      // scrubbed over the distance the hero takes to travel off the top of the
      // viewport instead — the video plays as it scrolls away, like a GIF that
      // happens to be tied to the wheel.
      if (range <= 0) {
        const passed = window.scrollY - section.offsetTop
        return clamp01(passed / Math.max(section.offsetHeight, 1))
      }
      const scrolled = window.scrollY - section.offsetTop
      // `span` < 1 ends the clip before the pin does; dividing by it stretches
      // the same 0..1 over a shorter piece of the scroll.
      return clamp01(scrolled / range / Math.max(cfg.span, 0.05))
    }

    // Sticky cannot be un-pinned from JS, so instead the stage is translated
    // against the pin: at release=1 it moves down exactly as fast as the pin
    // holds it up, which nets out to scrolling normally. Anything between is a
    // partial hold.
    // `release` shortens the section as well as unpinning the stage. Unpinning
    // alone would leave the same 4 screens of scroll behind an empty hero — the
    // trapped feeling would just move rather than go away. At release=1 the
    // section is one screen tall and the hero scrolls past like any other.
    const applyRelease = () => {
      const r = clamp01(cfg.release)
      section.style.setProperty('--release', String(r))
      if (stage) stage.style.position = r >= 1 ? 'relative' : 'sticky'
    }

    const drift = () => {
      if (!stage) return
      const r = clamp01(cfg.release)
      // At r=1 the stage is `relative` and moves on its own; no transform.
      if (r >= 1) {
        stage.style.transform = ''
        return
      }
      // offsetTop, not getBoundingClientRect: the rect is measured *after* this
      // transform is applied, so reading it here feeds the translation back
      // into its own input and the stage runs away.
      const held = Math.max(0, window.scrollY - section.offsetTop)
      const max = Math.max(0, section.offsetHeight - window.innerHeight)
      const y = Math.min(held, max) * r
      // Cleared rather than set to 0 so that release=0 leaves the stage with no
      // transform at all — a transform makes it a containing block.
      stage.style.transform = y > 0.5 ? `translate3d(0,${y.toFixed(1)}px,0)` : ''
    }

    // Driven by raw scroll, NOT the eased `current`. Easing is what makes the
    // video feel smooth, and it is also what would make this feel laggy — a
    // list that trails the wheel reads as broken, where a video that trails it
    // reads as cinematic. Kept out of `paint` because that loop stops once the
    // eased value settles, and the tail must track scroll for as long as
    // scrolling happens.
    // True while the list is on screen, so the rAF loop knows to keep going.
    let tailActive = false

    const paintTail = () => {
      if (!tail || !tailList) return
      const range = section.offsetHeight - window.innerHeight
      const scrolled = Math.max(0, window.scrollY - section.offsetTop)
      // Starts where the button becomes stable — the CTA is already carrying
      // the scroll until then, and two things moving at once read as clutter.
      const startPx = range * payoffWindow()[1]
      const past = scrolled - startPx
      tailActive = past > 0 && scrolled < range + window.innerHeight
      if (past <= 0) {
        tail.style.setProperty('--tail-in', '0')
        return
      }
      // Begins at the bottom of its box and travels up at true scroll speed.
      // No far-below entry offset: the list appears by opacity where it
      // already sits, rather than sliding in from somewhere off-screen.
      const boxH = tail.offsetHeight || window.innerHeight
      const y = boxH - past * cfg.tailRate
      tailList.style.setProperty('--tail-y', `${y.toFixed(1)}px`)
      // Fades over a short fixed distance so it is fully visible almost
      // immediately, then simply moves.
      const fadePx = Math.max(1, (range - startPx) * cfg.tailFade)
      const arrived = clamp01(past / fadePx)
      tail.style.setProperty('--tail-in', arrived.toFixed(3))
      // 0.5 → 1 over the same window as the fade.
      tailList.style.setProperty('--tail-scale', (0.5 + 0.5 * smooth(arrived)).toFixed(3))
    }

    const paint = () => {
      raf = 0
      const now = performance.now()
      const dt = telemetry.t ? now - telemetry.t : 16
      const prev = current

      // Ease toward the target instead of jumping to it: trackpad scroll
      // arrives in coarse steps, and seeking straight to them looks notchy.
      current += (target - current) * cfg.ease
      if (Math.abs(target - current) < 0.0004) current = target

      if (duration > 0) {
        const time = current * duration
        // Seeking to exactly `duration` can bounce back to 0 in Safari.
        if (Math.abs(video.currentTime - time) > 1 / 48) {
          const t0 = performance.now()
          video.currentTime = Math.min(time, duration - 0.02)
          telemetry.seekMs = performance.now() - t0
        }
      }

      telemetry.t = now
      telemetry.dt = dt
      telemetry.target = target
      telemetry.current = current
      telemetry.lag = target - current
      telemetry.velocity = ((current - prev) / dt) * 1000
      telemetry.scrollY = window.scrollY
      telemetry.painting = current !== target

      const p = progress()
      const windows = OUT()
      fades.forEach((el, i) => el.style.setProperty('--o', fadeOut(p, windows[i]).toFixed(3)))
      if (payoff) {
        // Keyed to raw track position, not `p`: `p` is divided by `span`, so
        // at span 0.3 it reaches 1 after a third of the scroll and the CTA
        // would arrive before the tail had even started. The payoff belongs at
        // the end of the *scroll*, whatever the clip is doing.
        const range = section.offsetHeight - window.innerHeight
        const raw = range > 0 ? clamp01((window.scrollY - section.offsetTop) / range) : p
        const [a, b] = payoffWindow()
        const arrived = smooth(clamp01((raw - a) / Math.max(b - a, 1e-6)))
        payoff.style.setProperty('--in', arrived.toFixed(3))
        payoff.style.setProperty('--payoff-events', arrived > 0.9 ? 'auto' : 'none')
        payoff.setAttribute('aria-hidden', arrived > 0.9 ? 'false' : 'true')
      }
      if (vignette) {
        const [a, b] = cfg.scrimOut
        vignette.style.setProperty('--scrim', (1 - cfg.scrimAmount * smooth(clamp01((p - a) / (b - a)))).toFixed(3))
      }
      if (hint) hint.style.setProperty('--hint', (1 - clamp01(p / 0.06)).toFixed(3))

      paintTail()

      // Keep painting while the tail is on screen, not just while the eased
      // video is catching up. Stopping the loop the moment the clip settles
      // left the tail and the CTA updating only on discrete scroll events —
      // which is precisely the à-coups: everything else was smooth because it
      // was on rAF, and these two were not.
      if (current !== target || tailActive) raf = requestAnimationFrame(paint)
    }

    const schedule = () => {
      applyRelease()
      target = progress()
      // Not inside `paint`: that loop stops once the eased value settles, but
      // these have to follow scroll for as long as scroll happens.
      drift()
      paintTail()
      if (!raf) raf = requestAnimationFrame(paint)
    }

    const ready = () => {
      duration = video.duration || 0
      schedule()
    }
    if (video.readyState >= 1) ready()
    else video.addEventListener('loadedmetadata', ready, { once: true })

    // Safari only paints the first frame after a play/pause round trip.
    video.play().then(() => video.pause()).catch(() => {})

    window.addEventListener('scroll', schedule, { passive: true })
    window.addEventListener('resize', schedule, { passive: true })
  }
</script>
