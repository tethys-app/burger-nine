---
// Verbatim from poc-website/index.html — static brand content.
import Nav from '../Nav.astro'

interface Props {
  storeCount?: number
}

const { storeCount = 0 } = Astro.props
---

    <Nav home />

    <!-- HERO -->
    <section class="hero" id="top">
      <div class="hero-copy">
        <span class="hero-kicker">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2l1.6 4.4L18 8l-4.4 1.6L12 14l-1.6-4.4L6 8l4.4-1.6L12 2z" /></svg>
          Smash burger · fait minute
        </span>
        <h1>Smashé.<br />Grillé.<br />Dévoré.</h1>
        <p class="hero-lede">Steak écrasé sur plancha brûlante, cheddar qui dégouline, pain toasté. À emporter ou livré, sans détour.</p>
        <div class="hero-act">
          <a class="btn bn-cta" href="#restos">Commander <svg viewBox="0 0 10 12" fill="currentColor" aria-hidden="true"><path d="M0 0l10 6-10 6z" /></svg></a>
          <a href="#carte" class="hero-menu-link">Voir la carte <span>→</span></a>
        </div>
        <p class="hero-micro"><a href="#franchise">Envie d'ouvrir un Burger Nine ?</a></p>
      </div>
      <div class="hero-product">
        <img src="/assets/generated/burger-hero-cutout-v1.png" alt="Double smash burger Burger Nine, bacon et cheddar fondu" fetchpriority="high" width="1254" height="1254" />
        <span class="hero-product-label">Attention,<br />ça dégouline.</span>
      </div>
    </section>
    <div class="bn-bar" id="bnBar">
      <a class="btn bn-cta" href="#restos">Commander <svg viewBox="0 0 10 12" fill="currentColor" aria-hidden="true"><path d="M0 0l10 6-10 6z" /></svg></a>
    </div>
    <script>
      const bar = document.getElementById('bnBar')
      const hero = document.getElementById('top')
      if (bar && hero) {
        const updateBar = () => bar.classList.toggle('on', window.scrollY > hero.offsetHeight * 0.55)
        window.addEventListener('scroll', updateBar, { passive: true })
        updateBar()
      }
      if (new Date().getHours() >= 19 || new Date().getHours() < 6) document.body.classList.add('night')
    </script>

    <!-- LA CARTE -->
    <section class="sec" id="carte">
      <div class="wrap">
        <div class="sec-head rv">
          <div>
            <div class="overline">01 · La carte</div>
            <h2>
              Quatre formats,
              <br />
              zéro chichi
            </h2>
            <a href="/carte" class="hero-menu-link cat-link">Voir le catalogue complet <span>→</span></a>
          </div>
        </div>
        <div class="cards">
          <article class="card rv">
            <div class="card-img">
              <span class="card-tag">Burgers</span>
              <img
                src="/assets/e629889733124b52.jpg"
                alt="Burger smashé Burger Nine"
                style="object-position: 50% 46%"
              />
            </div>
            <div class="card-body">
              <h3>Burgers</h3>
              <p>Steak smashé, cheddar fondu, pain toasté au beurre.</p>
            </div>
          </article>
          <article class="card rv">
            <div class="card-img">
              <span class="card-tag">Tacos</span>
              <img
                src="/assets/8cd0808be67fd412.jpg"
                alt="French tacos Burger Nine devant l'enseigne néon"
              />
            </div>
            <div class="card-body">
              <h3>Tacos</h3>
              <p>La sauce fromagère qui déborde, comme il faut.</p>
            </div>
          </article>
          <article class="card rv">
            <div class="card-img">
              <span class="card-tag">Riz Crousty</span>
              <img
                src="/assets/6e4759bfacbcceee.jpg"
                alt="Riz Crousty — riz et poulet croustillant sauce"
              />
            </div>
            <div class="card-body">
              <h3>Riz Crousty</h3>
              <p>Poulet croustillant, riz parfumé, sauce généreuse.</p>
            </div>
          </article>
          <article class="card rv">
            <div class="card-img">
              <span class="card-tag">Bowls</span>
              <img
                src="/assets/36daa6d021ebbfed.jpg"
                alt="Bowl bœuf smashé pickles cheddar"
              />
            </div>
            <div class="card-body">
              <h3>Bowls</h3>
              <p>Tout le smash, sans le pain — frais et généreux.</p>
            </div>
          </article>
        </div>
      </div>
    </section>

    <!-- SEP: drips noir -> hits -->
    <div class="hits">
      <svg
        class="sep"
        viewBox="0 0 1440 110"
        preserveAspectRatio="none"
        aria-hidden="true"
      >
        <path
          fill="#1E0B1A"
          d="M0,0 L1440,0 L1440,22 L1440,22 L1440,22 C1440,61.050000000000004 1435.95,93 1399.5,93 C1363.05,93 1359,61.050000000000004 1359,22 L1334,22 L1334,22 C1334,38.5 1330.55,52 1299.5,52 C1268.45,52 1265,38.5 1265,22 L1255,22 L1255,22 C1255,72.05000000000001 1249.65,113 1201.5,113 C1153.35,113 1148,72.05000000000001 1148,22 L1142,22 L1142,22 C1142,41.8 1137.8,58 1100.0,58 C1062.2,58 1058,41.8 1058,22 L1038,22 L1038,22 C1038,53.35 1033.5,79 993.0,79 C952.5,79 948,53.35 948,22 L940,22 L940,22 C940,79.75 935.65,127 896.5,127 C857.35,127 853,79.75 853,22 L828,22 L828,22 C828,41.8 825.3,58 801.0,58 C776.7,58 774,41.8 774,22 L756,22 L756,22 C756,69.85 751.15,109 707.5,109 C663.85,109 659,69.85 659,22 L639,22 L639,22 C639,36.3 635.05,48 599.5,48 C563.95,48 560,36.3 560,22 L549,22 L549,22 C549,55.550000000000004 545.65,83 515.5,83 C485.35,83 482,55.550000000000004 482,22 L475,22 L475,22 C475,52.25 472.0,77 445.0,77 C418.0,77 415,52.25 415,22 L393,22 L393,22 C393,73.7 388.55,116 348.5,116 C308.45,116 304,73.7 304,22 L296,22 L296,22 C296,45.1 291.2,64 248.0,64 C204.8,64 200,45.1 200,22 L182,22 L182,22 C182,57.2 177.05,86 132.5,86 C87.94999999999999,86 83,57.2 83,22 L74,22 L74,22 C74,66.0 70.5,102 39.0,102 C7.5,102 4,66.0 4,22 L0,22 Z"
        />
      </svg>
      <div class="hits-in" id="hits">
        <div class="wrap">
          <div class="sec-head rv">
            <div>
              <div class="overline">02 · Les hits</div>
              <h2>
                Ceux qu'on
                <br />
                recommande
              </h2>
            </div>
            <p class="side">
              Les recettes qui reviennent commande après commande.
            </p>
          </div>
          <div class="hits-row">
            <article class="hit rv">
              <div class="hit-img">
                <img
                  src="/assets/8d8bfc36ad278f95.jpg"
                  alt="Le Smash Bowl signature"
                  style="object-position: 50% 48%"
                />
                <a href="#restos" class="hit-discover">Découvrir</a>
              </div>
            </article>
            <article class="hit rv">
              <div class="hit-img">
                <img
                  src="/assets/02ed823ff0149d9c.jpg"
                  alt="Brochettes glazées BBQ"
                  style="object-position: 50% 62%"
                />
                <a href="#restos" class="hit-discover">Découvrir</a>
              </div>
            </article>
            <article class="hit rv">
              <div class="hit-img">
                <img
                  src="/assets/f26c8dda5aa27aad.jpg"
                  alt="Le Tandoor Sub"
                  style="object-position: 50% 30%"
                />
                <a href="#restos" class="hit-discover">Découvrir</a>
              </div>
            </article>
          </div>
        </div>
      </div>
    </div>

    <!-- SEP: drips magenta -> spot -->
    <svg
      class="sep"
      viewBox="0 0 1440 110"
      preserveAspectRatio="none"
      aria-hidden="true"
      style="background: transparent; margin-top: -1px"
    >
      <path
        fill="#823994"
        d="M0,0 L1440,0 L1440,22 L1440,22 L1440,22 C1440,61.050000000000004 1435.95,93 1399.5,93 C1363.05,93 1359,61.050000000000004 1359,22 L1334,22 L1334,22 C1334,38.5 1330.55,52 1299.5,52 C1268.45,52 1265,38.5 1265,22 L1255,22 L1255,22 C1255,72.05000000000001 1249.65,113 1201.5,113 C1153.35,113 1148,72.05000000000001 1148,22 L1142,22 L1142,22 C1142,41.8 1137.8,58 1100.0,58 C1062.2,58 1058,41.8 1058,22 L1038,22 L1038,22 C1038,53.35 1033.5,79 993.0,79 C952.5,79 948,53.35 948,22 L940,22 L940,22 C940,79.75 935.65,127 896.5,127 C857.35,127 853,79.75 853,22 L828,22 L828,22 C828,41.8 825.3,58 801.0,58 C776.7,58 774,41.8 774,22 L756,22 L756,22 C756,69.85 751.15,109 707.5,109 C663.85,109 659,69.85 659,22 L639,22 L639,22 C639,36.3 635.05,48 599.5,48 C563.95,48 560,36.3 560,22 L549,22 L549,22 C549,55.550000000000004 545.65,83 515.5,83 C485.35,83 482,55.550000000000004 482,22 L475,22 L475,22 C475,52.25 472.0,77 445.0,77 C418.0,77 415,52.25 415,22 L393,22 L393,22 C393,73.7 388.55,116 348.5,116 C308.45,116 304,73.7 304,22 L296,22 L296,22 C296,45.1 291.2,64 248.0,64 C204.8,64 200,45.1 200,22 L182,22 L182,22 C182,57.2 177.05,86 132.5,86 C87.94999999999999,86 83,57.2 83,22 L74,22 L74,22 C74,66.0 70.5,102 39.0,102 C7.5,102 4,66.0 4,22 L0,22 Z"
      />
    </svg>

    <!-- LE SPOT -->
    <section class="sec" id="spot" style="padding-top: 40px; padding-bottom: 20px">
      <div class="wrap">
        <div class="spot-grid">
          <div class="spot-txt rv">
            <div class="overline">03 · Le spot</div>
            <span class="neon-quote">« Askip c'est le meilleur spot du coin »</span>
            <h2
              style="
                font-family: var(--display);
                font-weight: 800;
                font-size: clamp(34px, 4.6vw, 56px);
                line-height: 1.02;
                text-transform: uppercase;
                margin-bottom: 22px;
              "
            >
              Le spot où
              <br />
              t'as ta place
            </h2>
            <div class="feat">
              <div class="feat-item">
                <div class="feat-ico">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2" />
                    <circle cx="9" cy="7" r="4" />
                    <path d="M23 21v-2a4 4 0 0 0-3-3.87" />
                    <path d="M16 3.13a4 4 0 0 1 0 7.75" />
                  </svg>
                </div>
                <div>
                  <b>Solo ou en bande</b>
                  <span>Entre deux cours, en pause déj', ou toute la bande le soir : t'as ta table.</span>
                </div>
              </div>
              <div class="feat-item">
                <div class="feat-ico">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                    <polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2" />
                  </svg>
                </div>
                <div>
                  <b>Une équipe à fond</b>
                  <span>Rapide, disponible, et toujours partante pour un sourire en plus.</span>
                </div>
              </div>
              <div class="feat-item">
                <div class="feat-ico">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M12 2l1.6 4.4L18 8l-4.4 1.6L12 14l-1.6-4.4L6 8l4.4-1.6L12 2z" />
                    <path d="M19 15l.8 2.2L22 18l-2.2.8L19 21l-.8-2.2L16 18l2.2-.8L19 15z" />
                  </svg>
                </div>
                <div>
                  <b>Un décor repensé</b>
                  <span>Néon, brique et bois brut — entre snack de quartier et street food assumée.</span>
                </div>
              </div>
            </div>
          </div>
          <div class="mosaic rv">
            <div class="m m1">
              <img
                src="/assets/8b3c04a6b0064c73.jpg"
                alt="Burger Nine servi en salle"
              />
            </div>
            <div class="m m2">
              <img
                src="/assets/c0ef2e775465d0aa.jpg"
                alt="Bowl Burger Nine devant le néon"
              />
            </div>
            <div class="m m3">
              <img
                src="/assets/f5f7d40f15150c44.jpg"
                alt="Plateaux à partager chez Burger Nine"
              />
            </div>
          </div>
        </div>

        <!-- FRANCHISE: le détail vit sur sa propre page, pas de doublon ici -->
        <div class="franchise-cta rv" id="franchise">
          <a href="/franchise" class="btn bn-cta">
            Ouvrir mon Burger Nine
            <svg viewBox="0 0 10 12" fill="currentColor" aria-hidden="true">
              <path d="M0 0l10 6-10 6z" />
            </svg>
          </a>
        </div>
      </div>
    </section>

    <!-- NOS RESTAURANTS -->
