---
// Verbatim from poc-website/index.html — static brand content.
import Nav from '../Nav.astro'
import { fr as t } from '../../i18n/fr'
import BnineButton from '../theme/BnineButton.astro'

interface Props {
  storeCount?: number
  /** Skip the built-in hero — /experimental supplies its own scrubbed one. */
  hero?: boolean
}

const { storeCount = 0, hero = true } = Astro.props
---

    <Nav home />
{hero && (
  <Fragment>
    <!-- HERO -->
    <section class="hero" id="top">
      <div class="hero-copy">
        <h1>{t.hero.headlineLead}<br />{t.hero.headlineMid}<span class="hl-frappe">{t.hero.headlineHighlight}</span><br />{t.hero.headlineTrail}.</h1>
        <p class="hero-tagline">{t.hero.headlineLines[0]} {t.hero.headlineLines[1]}</p>
        <div class="hero-act">
          <BnineButton href="#restos" arrow>{t.hero.cta}</BnineButton>
        </div>
        <p class="hero-micro"><a href="#franchise">{t.hero.micro}</a></p>
      </div>
      <div class="hero-city">
        <picture>
          <source media="(max-width: 760px)" srcset="/assets/generated/hero-city-mobile-v1.jpg" />
          <img src="/assets/generated/hero-city-v1.jpg" alt={t.hero.cityAlt} fetchpriority="high" width="3136" height="1344" />
        </picture>
      </div>
    </section>
  </Fragment>
)}
    <div class="bn-bar" id="bnBar">
      <BnineButton href="#restos" arrow>{t.hero.cta}</BnineButton>
    </div>
    <script>
      const bar = document.getElementById('bnBar')
      const hero = document.getElementById('top')
      if (bar && hero) {
        // On the scrubbed hero the section is several screens tall and the last
        // one already shows a CTA over the storefront — only take over once the
        // whole thing has been scrolled past, or the two CTAs stack.
        const threshold = hero.classList.contains('scrub') ? 1 : 0.55
        const updateBar = () => bar.classList.toggle('on', window.scrollY > hero.offsetHeight * threshold)
        window.addEventListener('scroll', updateBar, { passive: true })
        updateBar()
      }
      if (new Date().getHours() >= 19 || new Date().getHours() < 6) document.body.classList.add('night')

      // Subtle parallax on the city shot: drifts slower than the page, so
      // it reads as sitting behind the gradient rather than printed on it.
      // Absent on /experimental, where the hero is a scrubbed video instead.
      const city = document.querySelector<HTMLElement>('.hero-city img')
      const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches
      if (city && hero && !reduceMotion) {
        let ticking = false
        const updateParallax = () => {
          ticking = false
          const progress = Math.min(1, Math.max(0, window.scrollY / hero.offsetHeight))
          city.style.transform = `translateY(${progress * 24}px)`
        }
        window.addEventListener(
          'scroll',
          () => {
            if (!ticking) {
              ticking = true
              requestAnimationFrame(updateParallax)
            }
          },
          { passive: true },
        )
      }
    </script>

    <!-- LA CARTE -->
    <section class="sec" id="carte">
      <div class="wrap">
        <div class="sec-head rv">
          <div>
            <div class="overline">{t.carte.overline}</div>
            <h2>{t.carte.title}</h2>
            <a href="/carte" class="hero-menu-link cat-link">{t.carte.catalogueLink} <span>→</span></a>
          </div>
        </div>
        <div class="cards">
          <article class="card rv">
            <div class="card-img">
              <span class="card-tag">{t.carte.items.burgers.name}</span>
              <img
                src="/assets/la-carte-burgers.jpg"
                alt={t.carte.items.burgers.alt}
                style="object-position: 50% 32%"
              />
            </div>
            <div class="card-body">
              <h3>{t.carte.items.burgers.name}</h3>
            </div>
          </article>
          <article class="card rv">
            <div class="card-img">
              <span class="card-tag">{t.carte.items.tacos.name}</span>
              <img
                src="/assets/la-carte-tacos.jpg"
                alt={t.carte.items.tacos.alt}
                style="object-position: 50% 38%"
              />
            </div>
            <div class="card-body">
              <h3>{t.carte.items.tacos.name}</h3>
            </div>
          </article>
          <article class="card rv">
            <div class="card-img">
              <span class="card-tag">{t.carte.items.rizCrousty.name}</span>
              <img
                src="/assets/la-carte-riz-crousty.jpg"
                alt={t.carte.items.rizCrousty.alt}
                style="object-position: 50% 30%"
              />
            </div>
            <div class="card-body">
              <h3>{t.carte.items.rizCrousty.name}</h3>
            </div>
          </article>
          <article class="card rv">
            <div class="card-img">
              <span class="card-tag">{t.carte.items.bowls.name}</span>
              <img
                src="/assets/la-carte-bowls.jpg"
                alt={t.carte.items.bowls.alt}
                style="object-position: 50% 28%"
              />
            </div>
            <div class="card-body">
              <h3>{t.carte.items.bowls.name}</h3>
            </div>
          </article>
        </div>
      </div>
    </section>

    <!-- SEP: drips noir -> hits -->
    <div class="hits">
      <svg
        class="sep"
        viewBox="0 0 1440 110"
        preserveAspectRatio="none"
        aria-hidden="true"
      >
        <path
          fill="#1E0B1A"
          d="M0,0 L1440,0 L1440,22 L1440,22 L1440,22 C1440,61.050000000000004 1435.95,93 1399.5,93 C1363.05,93 1359,61.050000000000004 1359,22 L1334,22 L1334,22 C1334,38.5 1330.55,52 1299.5,52 C1268.45,52 1265,38.5 1265,22 L1255,22 L1255,22 C1255,72.05000000000001 1249.65,113 1201.5,113 C1153.35,113 1148,72.05000000000001 1148,22 L1142,22 L1142,22 C1142,41.8 1137.8,58 1100.0,58 C1062.2,58 1058,41.8 1058,22 L1038,22 L1038,22 C1038,53.35 1033.5,79 993.0,79 C952.5,79 948,53.35 948,22 L940,22 L940,22 C940,79.75 935.65,127 896.5,127 C857.35,127 853,79.75 853,22 L828,22 L828,22 C828,41.8 825.3,58 801.0,58 C776.7,58 774,41.8 774,22 L756,22 L756,22 C756,69.85 751.15,109 707.5,109 C663.85,109 659,69.85 659,22 L639,22 L639,22 C639,36.3 635.05,48 599.5,48 C563.95,48 560,36.3 560,22 L549,22 L549,22 C549,55.550000000000004 545.65,83 515.5,83 C485.35,83 482,55.550000000000004 482,22 L475,22 L475,22 C475,52.25 472.0,77 445.0,77 C418.0,77 415,52.25 415,22 L393,22 L393,22 C393,73.7 388.55,116 348.5,116 C308.45,116 304,73.7 304,22 L296,22 L296,22 C296,45.1 291.2,64 248.0,64 C204.8,64 200,45.1 200,22 L182,22 L182,22 C182,57.2 177.05,86 132.5,86 C87.94999999999999,86 83,57.2 83,22 L74,22 L74,22 C74,66.0 70.5,102 39.0,102 C7.5,102 4,66.0 4,22 L0,22 Z"
        />
      </svg>
      <div class="hits-in" id="hits">
        <div class="wrap">
          <div class="sec-head rv">
            <div>
              <div class="overline">{t.hits.overline}</div>
              <h2>
                {t.hits.title[0]}
                <br />
                {t.hits.title[1]}
              </h2>
            </div>
            <p class="side">
              {t.hits.side}
            </p>
          </div>
          <div class="hits-row">
            <article class="hit rv">
              <div class="hit-img">
                <img
                  src="/assets/hits-smash-bowl.jpg"
                  alt={t.hits.items.smashBowl.alt}
                  style="object-position: 44% 34%"
                />
                <a href="#restos" class="hit-discover">{t.hits.discover}</a>
              </div>
            </article>
            <article class="hit rv">
              <div class="hit-img">
                <img
                  src="/assets/hits-brochettes.jpg"
                  alt={t.hits.items.brochettes.alt}
                  style="object-position: 28% 26%"
                />
                <a href="#restos" class="hit-discover">{t.hits.discover}</a>
              </div>
            </article>
            <article class="hit rv">
              <div class="hit-img">
                <img
                  src="/assets/hits-tandoor-sub.jpg"
                  alt={t.hits.items.tandoorSub.alt}
                  style="object-position: 46% 28%"
                />
                <a href="#restos" class="hit-discover">{t.hits.discover}</a>
              </div>
            </article>
          </div>
        </div>
      </div>
    </div>

    <!-- SEP: drips magenta -> spot -->
    <svg
      class="sep"
      viewBox="0 0 1440 110"
      preserveAspectRatio="none"
      aria-hidden="true"
      style="background: transparent; margin-top: -1px"
    >
      <path
        fill="#823994"
        d="M0,0 L1440,0 L1440,22 L1440,22 L1440,22 C1440,61.050000000000004 1435.95,93 1399.5,93 C1363.05,93 1359,61.050000000000004 1359,22 L1334,22 L1334,22 C1334,38.5 1330.55,52 1299.5,52 C1268.45,52 1265,38.5 1265,22 L1255,22 L1255,22 C1255,72.05000000000001 1249.65,113 1201.5,113 C1153.35,113 1148,72.05000000000001 1148,22 L1142,22 L1142,22 C1142,41.8 1137.8,58 1100.0,58 C1062.2,58 1058,41.8 1058,22 L1038,22 L1038,22 C1038,53.35 1033.5,79 993.0,79 C952.5,79 948,53.35 948,22 L940,22 L940,22 C940,79.75 935.65,127 896.5,127 C857.35,127 853,79.75 853,22 L828,22 L828,22 C828,41.8 825.3,58 801.0,58 C776.7,58 774,41.8 774,22 L756,22 L756,22 C756,69.85 751.15,109 707.5,109 C663.85,109 659,69.85 659,22 L639,22 L639,22 C639,36.3 635.05,48 599.5,48 C563.95,48 560,36.3 560,22 L549,22 L549,22 C549,55.550000000000004 545.65,83 515.5,83 C485.35,83 482,55.550000000000004 482,22 L475,22 L475,22 C475,52.25 472.0,77 445.0,77 C418.0,77 415,52.25 415,22 L393,22 L393,22 C393,73.7 388.55,116 348.5,116 C308.45,116 304,73.7 304,22 L296,22 L296,22 C296,45.1 291.2,64 248.0,64 C204.8,64 200,45.1 200,22 L182,22 L182,22 C182,57.2 177.05,86 132.5,86 C87.94999999999999,86 83,57.2 83,22 L74,22 L74,22 C74,66.0 70.5,102 39.0,102 C7.5,102 4,66.0 4,22 L0,22 Z"
      />
    </svg>

    <!-- LE SPOT -->
    <section class="sec" id="spot" style="padding-top: 40px; padding-bottom: 20px">
      <div class="wrap">
        <div class="spot-grid">
          <div class="spot-txt rv">
            <div class="overline">{t.spot.overline}</div>
            <span class="neon-quote">{t.spot.quote}</span>
            <h2
              style="
                font-family: var(--display);
                font-weight: 800;
                font-size: clamp(34px, 4.6vw, 56px);
                line-height: 1.02;
                text-transform: uppercase;
                margin-bottom: 22px;
              "
            >
              {t.spot.title[0]}
              <br />
              {t.spot.title[1]}
            </h2>

            <!-- FRANCHISE: le détail vit sur sa propre page, pas de doublon ici -->
            <div class="franchise-cta" id="franchise">
              <a href="/franchise" class="btn bn-cta gold">
                {t.spot.franchiseCta}
                <svg viewBox="0 0 10 12" fill="currentColor" aria-hidden="true">
                  <path d="M0 0l10 6-10 6z" />
                </svg>
              </a>
            </div>
          </div>
          <div class="mosaic rv">
            <div class="m m1">
              <img
                src="/assets/8b3c04a6b0064c73.jpg"
                alt={t.spot.images.salle.alt}
              />
            </div>
            <div class="m m2">
              <img
                src="/assets/c0ef2e775465d0aa.jpg"
                alt={t.spot.images.bowlNeon.alt}
              />
            </div>
            <div class="m m3">
              <img
                src="/assets/f5f7d40f15150c44.jpg"
                alt={t.spot.images.plateaux.alt}
              />
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- NOS RESTAURANTS -->
