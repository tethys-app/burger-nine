---
// Verbatim from poc-website/index.html — static brand content.
import Nav from '../Nav.astro'

interface Props {
  storeCount?: number
}

const { storeCount = 0 } = Astro.props
---

    <Nav home />

    <!-- HERO -->
    <section class="hero" id="top">
      <div class="hero-copy">
        <span class="hero-kicker">
          <svg viewBox="0 0 9 12" fill="currentColor" aria-hidden="true"><path d="M4.5 0C2 0 0 2 0 4.5 0 8 4.5 12 4.5 12S9 8 9 4.5C9 2 7 0 4.5 0z" /></svg>
          <span>{storeCount} restaurant{storeCount === 1 ? '' : 's'} ouvert{storeCount === 1 ? '' : 's'}</span>
        </span>
        <h1>La meilleure<br /><em>frappe</em><br />du quartier</h1>
        <p class="hero-lede">Smashés minute, cheddar qui coule, recettes qui cognent.</p>
        <div class="hero-act">
          <a class="btn bn-cta" href="#restos">Je commande <svg viewBox="0 0 10 12" fill="currentColor" aria-hidden="true"><path d="M0 0l10 6-10 6z" /></svg></a>
          <a class="hero-menu-link" href="#carte">Voir la carte <span aria-hidden="true">↓</span></a>
        </div>
        <div class="hero-sub">
          <span class="hero-proof"><svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2l2.9 6.3 6.9.8-5.1 4.7 1.4 6.8L12 17.3 5.9 20.6l1.4-6.8L2.2 9.1l6.9-.8L12 2z" /></svg><b>{storeCount} restaurants</b> ouverts en Auvergne-Rhône-Alpes</span>
        </div>
        <p class="hero-micro"><a href="#franchise">Ouvrir un Burger Nine</a></p>
      </div>
      <div class="hero-product">
        <div class="hero-sticker">100%<br />KIFF</div>
        <img src="/assets/generated/burger-hero-cutout-v1.png" alt="Double smash burger Burger Nine, bacon et cheddar fondu" fetchpriority="high" width="1254" height="1254" />
        <span class="hero-product-label">Le smash<br />qui fait parler</span>
      </div>
    </section>
    <div class="bn-bar" id="bnBar">
      <div class="bn-bar-txt"><b>Burger Nine</b><span>{storeCount} restaurants ouverts</span></div>
      <a class="btn bn-cta" href="#restos">Commander <svg viewBox="0 0 10 12" fill="currentColor" aria-hidden="true"><path d="M0 0l10 6-10 6z" /></svg></a>
    </div>
    <script>
      const bar = document.getElementById('bnBar')
      const hero = document.getElementById('top')
      if (bar && hero) {
        const updateBar = () => bar.classList.toggle('on', window.scrollY > hero.offsetHeight * 0.55)
        window.addEventListener('scroll', updateBar, { passive: true })
        updateBar()
      }
      if (new Date().getHours() >= 19 || new Date().getHours() < 6) document.body.classList.add('night')
    </script>

    <!-- MARQUEE -->
    <div class="marquee" aria-hidden="true">
      <div class="marquee-track">
        <span>
          Burgers
          <i>✦</i>
        </span>
        <span>
          Tacos
          <i>✦</i>
        </span>
        <span>
          Bowls
          <i>✦</i>
        </span>
        <span>
          Riz Crousty
          <i>✦</i>
        </span>
        <span>
          Originaan
          <i>✦</i>
        </span>
        <span>
          Sandwichs
          <i>✦</i>
        </span>
        <span>
          Desserts
          <i>✦</i>
        </span>
        <span>
          Burgers
          <i>✦</i>
        </span>
        <span>
          Tacos
          <i>✦</i>
        </span>
        <span>
          Bowls
          <i>✦</i>
        </span>
        <span>
          Riz Crousty
          <i>✦</i>
        </span>
        <span>
          Originaan
          <i>✦</i>
        </span>
        <span>
          Sandwichs
          <i>✦</i>
        </span>
        <span>
          Desserts
          <i>✦</i>
        </span>
      </div>
    </div>

    <!-- LA CARTE -->
    <section class="sec" id="carte">
      <div class="wrap">
        <div class="sec-head rv">
          <div>
            <div class="overline">01 · La carte</div>
            <h2>
              La carte
              <br />
              du Nine
            </h2>
          </div>
          <p class="side">
            Quatre familles, zéro fausse note. Le détail se découvre en boutique
            et sur l'app de commande.
          </p>
        </div>
        <div class="cards">
          <article class="card rv">
            <div class="card-img">
              <span class="card-tag">Burgers</span>
              <img
                src="/assets/e629889733124b52.jpg"
                alt="Burger smashé Burger Nine"
                style="object-position: 50% 46%"
              />
            </div>
            <div class="card-body">
              <h3>Burgers</h3>
              <p>Smashés minute, cheddar coulant, pain brioché toasté.</p>
            </div>
          </article>
          <article class="card rv">
            <div class="card-img">
              <span class="card-tag">Tacos</span>
              <img
                src="/assets/8cd0808be67fd412.jpg"
                alt="French tacos Burger Nine devant l'enseigne néon"
              />
            </div>
            <div class="card-body">
              <h3>Tacos</h3>
              <p>Pliés serrés, garnis lourds, sauces au choix.</p>
            </div>
          </article>
          <article class="card rv">
            <div class="card-img">
              <span class="card-tag">Riz Crousty</span>
              <img
                src="/assets/6e4759bfacbcceee.jpg"
                alt="Riz Crousty — riz et poulet croustillant sauce"
              />
            </div>
            <div class="card-body">
              <h3>Riz Crousty</h3>
              <p>Riz moelleux, poulet crousty, sauces qui débordent.</p>
            </div>
          </article>
          <article class="card rv">
            <div class="card-img">
              <span class="card-tag">Bowls</span>
              <img
                src="/assets/36daa6d021ebbfed.jpg"
                alt="Bowl bœuf smashé pickles cheddar"
              />
            </div>
            <div class="card-body">
              <h3>Bowls</h3>
              <p>Fries, viande smashée, toppings — tout dans le bol.</p>
            </div>
          </article>
        </div>
        <div class="more-row rv">
          <span class="more-lbl">Et aussi</span>
          <span class="chip2">Originaan</span>
          <span class="chip2">Menu Kids</span>
          <span class="chip2">Boissons</span>
          <span class="chip2">Café & Thé</span>
        </div>
      </div>
    </section>

    <!-- SEP: drips noir -> hits -->
    <div class="hits">
      <svg
        class="sep"
        viewBox="0 0 1440 110"
        preserveAspectRatio="none"
        aria-hidden="true"
      >
        <path
          fill="#1E0B1A"
          d="M0,0 L1440,0 L1440,22 L1440,22 L1440,22 C1440,61.050000000000004 1435.95,93 1399.5,93 C1363.05,93 1359,61.050000000000004 1359,22 L1334,22 L1334,22 C1334,38.5 1330.55,52 1299.5,52 C1268.45,52 1265,38.5 1265,22 L1255,22 L1255,22 C1255,72.05000000000001 1249.65,113 1201.5,113 C1153.35,113 1148,72.05000000000001 1148,22 L1142,22 L1142,22 C1142,41.8 1137.8,58 1100.0,58 C1062.2,58 1058,41.8 1058,22 L1038,22 L1038,22 C1038,53.35 1033.5,79 993.0,79 C952.5,79 948,53.35 948,22 L940,22 L940,22 C940,79.75 935.65,127 896.5,127 C857.35,127 853,79.75 853,22 L828,22 L828,22 C828,41.8 825.3,58 801.0,58 C776.7,58 774,41.8 774,22 L756,22 L756,22 C756,69.85 751.15,109 707.5,109 C663.85,109 659,69.85 659,22 L639,22 L639,22 C639,36.3 635.05,48 599.5,48 C563.95,48 560,36.3 560,22 L549,22 L549,22 C549,55.550000000000004 545.65,83 515.5,83 C485.35,83 482,55.550000000000004 482,22 L475,22 L475,22 C475,52.25 472.0,77 445.0,77 C418.0,77 415,52.25 415,22 L393,22 L393,22 C393,73.7 388.55,116 348.5,116 C308.45,116 304,73.7 304,22 L296,22 L296,22 C296,45.1 291.2,64 248.0,64 C204.8,64 200,45.1 200,22 L182,22 L182,22 C182,57.2 177.05,86 132.5,86 C87.94999999999999,86 83,57.2 83,22 L74,22 L74,22 C74,66.0 70.5,102 39.0,102 C7.5,102 4,66.0 4,22 L0,22 Z"
        />
      </svg>
      <div class="hits-in" id="hits">
        <div class="wrap">
          <div class="sec-head rv">
            <div>
              <div class="overline">02 · Les hits</div>
              <h2>
                Les hits
                <br />
                du moment
              </h2>
            </div>
            <p class="side">
              La sélection qui tourne fort en ce moment chez le Nine.
            </p>
          </div>
          <div class="hits-row">
            <article class="hit rv">
              <div class="hit-img">
                <span class="hit-tag">Signature</span>
                <img
                  src="/assets/8d8bfc36ad278f95.jpg"
                  alt="Le Smash Bowl signature"
                  style="object-position: 50% 48%"
                />
              </div>
              <div class="hit-body">
                <h3>Le Smash Bowl</h3>
                <p>Bœuf smashé, cheddar, pickles — la base du kiff.</p>
              </div>
            </article>
            <article class="hit rv">
              <div class="hit-img">
                <span class="hit-tag">Grill</span>
                <img
                  src="/assets/02ed823ff0149d9c.jpg"
                  alt="Brochettes glazées BBQ"
                  style="object-position: 50% 62%"
                />
              </div>
              <div class="hit-body">
                <h3>Brochettes glazées</h3>
                <p>Marinées, grillées minute, laquées BBQ fumée.</p>
              </div>
            </article>
            <article class="hit rv">
              <div class="hit-img">
                <span class="hit-tag">Spicy</span>
                <img
                  src="/assets/f26c8dda5aa27aad.jpg"
                  alt="Le Tandoor Sub"
                  style="object-position: 50% 30%"
                />
              </div>
              <div class="hit-body">
                <h3>Le Tandoor Sub</h3>
                <p>Poulet façon tandoori, cheddar coulant, pain toasté.</p>
              </div>
            </article>
          </div>
        </div>
      </div>
    </div>

    <!-- SEP: drips magenta -> spot -->
    <svg
      class="sep"
      viewBox="0 0 1440 110"
      preserveAspectRatio="none"
      aria-hidden="true"
      style="background: transparent; margin-top: -1px"
    >
      <path
        fill="#823994"
        d="M0,0 L1440,0 L1440,22 L1440,22 L1440,22 C1440,61.050000000000004 1435.95,93 1399.5,93 C1363.05,93 1359,61.050000000000004 1359,22 L1334,22 L1334,22 C1334,38.5 1330.55,52 1299.5,52 C1268.45,52 1265,38.5 1265,22 L1255,22 L1255,22 C1255,72.05000000000001 1249.65,113 1201.5,113 C1153.35,113 1148,72.05000000000001 1148,22 L1142,22 L1142,22 C1142,41.8 1137.8,58 1100.0,58 C1062.2,58 1058,41.8 1058,22 L1038,22 L1038,22 C1038,53.35 1033.5,79 993.0,79 C952.5,79 948,53.35 948,22 L940,22 L940,22 C940,79.75 935.65,127 896.5,127 C857.35,127 853,79.75 853,22 L828,22 L828,22 C828,41.8 825.3,58 801.0,58 C776.7,58 774,41.8 774,22 L756,22 L756,22 C756,69.85 751.15,109 707.5,109 C663.85,109 659,69.85 659,22 L639,22 L639,22 C639,36.3 635.05,48 599.5,48 C563.95,48 560,36.3 560,22 L549,22 L549,22 C549,55.550000000000004 545.65,83 515.5,83 C485.35,83 482,55.550000000000004 482,22 L475,22 L475,22 C475,52.25 472.0,77 445.0,77 C418.0,77 415,52.25 415,22 L393,22 L393,22 C393,73.7 388.55,116 348.5,116 C308.45,116 304,73.7 304,22 L296,22 L296,22 C296,45.1 291.2,64 248.0,64 C204.8,64 200,45.1 200,22 L182,22 L182,22 C182,57.2 177.05,86 132.5,86 C87.94999999999999,86 83,57.2 83,22 L74,22 L74,22 C74,66.0 70.5,102 39.0,102 C7.5,102 4,66.0 4,22 L0,22 Z"
      />
    </svg>

    <!-- LE SPOT -->
    <section class="sec" id="spot" style="padding-top: 40px">
      <div class="wrap">
        <div class="spot-grid">
          <div class="spot-txt rv">
            <div class="overline">03 · Le spot</div>
            <span class="neon-quote">« Y'a le kho, c'est cher bon »</span>
            <h2
              style="
                font-family: var(--display);
                font-weight: 800;
                font-size: clamp(34px, 4.6vw, 56px);
                line-height: 1.02;
                text-transform: uppercase;
                margin-bottom: 22px;
              "
            >
              Un spot taillé
              <br />
              pour le kiff
            </h2>
            <div class="feat">
              <div class="feat-item">
                <div class="feat-ico">
                  <svg
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.8"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  >
                    <path d="M13 2L6 13h5l-2 9 9-12h-6l1-8z" />
                  </svg>
                </div>
                <div><b>Néons & déco signature</b></div>
              </div>
              <div class="feat-item">
                <div class="feat-ico">
                  <svg
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.8"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  >
                    <path d="M5 11V8a2 2 0 012-2h10a2 2 0 012 2v3" />
                    <path d="M3 11h18v5a2 2 0 01-2 2H5a2 2 0 01-2-2v-5z" />
                    <path d="M6 18v2M18 18v2" />
                  </svg>
                </div>
                <div><b>Sur place, banquettes & tablées</b></div>
              </div>
              <div class="feat-item">
                <div class="feat-ico">
                  <svg
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.8"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  >
                    <path
                      d="M6 8h12l-1.2 12.2a2 2 0 01-2 1.8H9.2a2 2 0 01-2-1.8L6 8z"
                    />
                    <path d="M9 8V6a3 3 0 016 0v2" />
                  </svg>
                </div>
                <div><b>À emporter & en livraison</b></div>
              </div>
            </div>
          </div>
          <div class="mosaic rv">
            <div class="m m1">
              <img
                src="/assets/8b3c04a6b0064c73.jpg"
                alt="Burger Nine servi en salle"
              />
            </div>
            <div class="m m2">
              <img
                src="/assets/c0ef2e775465d0aa.jpg"
                alt="Bowl Burger Nine devant le néon"
              />
            </div>
            <div class="m m3">
              <img
                src="/assets/f5f7d40f15150c44.jpg"
                alt="Plateaux à partager chez Burger Nine"
              />
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- NOS RESTAURANTS -->
