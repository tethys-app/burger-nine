---
// Footer, shared across the landing page and every standalone page (/franchise,
// /carte, /carrieres). The section anchors (#hits, #spot…) only exist on the
// homepage, so off-home they need the `/` prefix to resolve there first.
import { fr as t } from '../../i18n/fr'

interface Props {
  home?: boolean
}
const { home = false } = Astro.props
const to = (hash: string) => (home ? hash : `/${hash}`)
---
    <!-- FOOTER -->
    <footer>
      <div class="wrap foot">
        <img
          class="flogo"
          src="/assets/f4c82effa1f42578.png"
          alt="Burger Nine"
        />
        <div class="ftag">{t.footer.tagline}</div>
        <nav aria-label={t.footer.footerAria}>
          <a href="/carte">{t.footer.nav.carte}</a>
          <a href={to('#hits')}>{t.footer.nav.hits}</a>
          <a href={to('#spot')}>{t.footer.nav.spot}</a>
          <a href={to('#restos')}>{t.footer.nav.restos}</a>
          <a href="/franchise">{t.footer.nav.franchise}</a>
          <a href="/carrieres">{t.footer.nav.carrieres}</a>
          <a href={to('#restos')}>{t.footer.nav.commander}</a>
        </nav>
        <div class="socials">
          <a
            class="soc"
            href="https://www.instagram.com/b9.burgernine/"
            target="_blank"
            rel="noopener"
          >
            <span class="ico">
              <svg
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.8"
              >
                <rect x="3" y="3" width="18" height="18" rx="5" />
                <circle cx="12" cy="12" r="4.2" />
                <circle
                  cx="17.4"
                  cy="6.6"
                  r="1.2"
                  fill="currentColor"
                  stroke="none"
                />
              </svg>
            </span>
            <span>
              <b>{t.footer.socials.instagram.handle}</b>
              <small>{t.footer.socials.instagram.label}</small>
            </span>
          </a>
          <a
            class="soc"
            href="https://www.tiktok.com/@b9off"
            target="_blank"
            rel="noopener"
          >
            <span class="ico">
              <svg viewBox="0 0 24 24" fill="currentColor">
                <path
                  d="M16.5 3c.4 2.1 1.8 3.6 4 3.9v3c-1.6 0-3-.5-4-1.3v6.9c0 3.5-2.4 5.9-5.8 5.9-3.2 0-5.7-2.4-5.7-5.6 0-3.1 2.4-5.6 5.6-5.6.3 0 .7 0 1 .1v3.2c-.3-.1-.6-.2-1-.2-1.4 0-2.5 1.1-2.5 2.5s1.1 2.5 2.5 2.5c1.5 0 2.7-1.1 2.7-2.9V3h3.2z"
                />
              </svg>
            </span>
            <span>
              <b>{t.footer.socials.tiktok.handle}</b>
              <small>{t.footer.socials.tiktok.label}</small>
            </span>
          </a>
          <a
            class="soc"
            href="https://www.facebook.com/Burger9Officiel/"
            target="_blank"
            rel="noopener"
          >
            <span class="ico">
              <svg viewBox="0 0 24 24" fill="currentColor">
                <path
                  d="M13.5 21v-7h2.4l.4-2.8h-2.8V9.4c0-.8.4-1.6 1.7-1.6h1.3V5.4c-.8-.1-1.6-.2-2.4-.2-2.4 0-4 1.5-4 4.1v1.9H7.5V14h2.6v7h3.4z"
                />
              </svg>
            </span>
            <span>
              <b>{t.footer.socials.facebook.handle}</b>
              <small>{t.footer.socials.facebook.label}</small>
            </span>
          </a>
        </div>
        <div class="legal">
          <a href="#">{t.footer.legal.mentions}</a>
          <a href="#">{t.footer.legal.cgv}</a>
          <a href="#">{t.footer.legal.confidentialite}</a>
        </div>
        <p class="copy">{t.footer.copyright}</p>
      </div>
    </footer>
