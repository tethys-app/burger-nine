---
// Verbatim from poc-website/index.html — franchise + footer.
---
    <section class="sec" id="franchise" style="padding-top: 80px">
      <div class="wrap">
        <div class="franchise-grid">
          <div class="rv">
            <div class="overline">05 · Franchise</div>
            <h2
              style="
                font-family: var(--display);
                font-weight: 800;
                font-size: clamp(34px, 4.6vw, 56px);
                line-height: 1.02;
                text-transform: uppercase;
                margin-bottom: 22px;
              "
            >
              Ouvre ton
              <br />
              Burger Nine
            </h2>
            <p style="color: var(--muted); font-size: 16.5px; max-width: 450px">
              Seize restaurants, cinq départements, une identité qui claque — et
              une région qui en redemande. Le prochain spot, c'est peut-être le
              tien.
            </p>
            <div
              class="cta-row"
              style="
                display: flex;
                gap: 16px;
                flex-wrap: wrap;
                margin-top: 34px;
              "
            >
              <a
                href="https://www.instagram.com/b9.burgernine/"
                target="_blank"
                rel="noopener"
                class="btn btn-solid"
              >
                NOUS ÉCRIRE SUR INSTAGRAM
                <svg viewBox="0 0 10 12" fill="currentColor" aria-hidden="true">
                  <path d="M0 0l10 6-10 6z" />
                </svg>
              </a>
            </div>
          </div>
          <div class="fr-visual rv">
            <figure class="fr-card">
              <img
                src="/assets/6c07fc3d54cb76ac.jpg"
                alt="Devanture d'un restaurant Burger Nine de nuit"
              />
            </figure>
          </div>
        </div>
      </div>
    </section>

    <!-- COMMANDER -->
    <section class="order" id="commander">
      <div class="wrap">
        <div class="order-grid">
          <div class="rv">
            <div class="overline">06 · Commander</div>
            <h2
              style="
                font-family: var(--display);
                font-weight: 800;
                font-size: clamp(34px, 4.6vw, 56px);
                line-height: 1.02;
                text-transform: uppercase;
                margin-bottom: 18px;
              "
            >
              Envie du
              <span class="pk">kiff</span>
              ?
            </h2>
            <p class="lead">
              Sur place, à emporter ou en livraison — la commande en ligne
              arrive bientôt.
            </p>
            <div
              class="cta-row"
              style="display: flex; gap: 16px; flex-wrap: wrap"
            >
              <a href="#restos" class="btn btn-solid">
                NOS RESTAURANTS
                <svg viewBox="0 0 10 12" fill="currentColor" aria-hidden="true">
                  <path d="M0 0l10 6-10 6z" />
                </svg>
              </a>
            </div>
            <div class="socials">
              <a
                class="soc"
                href="https://www.instagram.com/b9.burgernine/"
                target="_blank"
                rel="noopener"
              >
                <span class="ico">
                  <svg
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.8"
                  >
                    <rect x="3" y="3" width="18" height="18" rx="5" />
                    <circle cx="12" cy="12" r="4.2" />
                    <circle
                      cx="17.4"
                      cy="6.6"
                      r="1.2"
                      fill="currentColor"
                      stroke="none"
                    />
                  </svg>
                </span>
                <span>
                  <b>@b9.burgernine</b>
                  <small>Instagram</small>
                </span>
              </a>
              <a
                class="soc"
                href="https://www.tiktok.com/@b9off"
                target="_blank"
                rel="noopener"
              >
                <span class="ico">
                  <svg viewBox="0 0 24 24" fill="currentColor">
                    <path
                      d="M16.5 3c.4 2.1 1.8 3.6 4 3.9v3c-1.6 0-3-.5-4-1.3v6.9c0 3.5-2.4 5.9-5.8 5.9-3.2 0-5.7-2.4-5.7-5.6 0-3.1 2.4-5.6 5.6-5.6.3 0 .7 0 1 .1v3.2c-.3-.1-.6-.2-1-.2-1.4 0-2.5 1.1-2.5 2.5s1.1 2.5 2.5 2.5c1.5 0 2.7-1.1 2.7-2.9V3h3.2z"
                    />
                  </svg>
                </span>
                <span>
                  <b>@b9off</b>
                  <small>TikTok</small>
                </span>
              </a>
              <a
                class="soc"
                href="https://www.facebook.com/Burger9Officiel/"
                target="_blank"
                rel="noopener"
              >
                <span class="ico">
                  <svg viewBox="0 0 24 24" fill="currentColor">
                    <path
                      d="M13.5 21v-7h2.4l.4-2.8h-2.8V9.4c0-.8.4-1.6 1.7-1.6h1.3V5.4c-.8-.1-1.6-.2-2.4-.2-2.4 0-4 1.5-4 4.1v1.9H7.5V14h2.6v7h3.4z"
                    />
                  </svg>
                </span>
                <span>
                  <b>Burger9Officiel</b>
                  <small>Facebook</small>
                </span>
              </a>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- FOOTER -->
    <footer>
      <div class="wrap foot">
        <img
          class="flogo"
          src="/assets/f4c82effa1f42578.png"
          alt="Burger Nine"
        />
        <div class="ftag">T'es à un croc du kiff</div>
        <nav aria-label="Pied de page">
          <a href="#carte">La carte</a>
          <a href="#hits">Les hits</a>
          <a href="#spot">Le spot</a>
          <a href="#restos">Nos restaurants</a>
          <a href="#franchise">Franchise</a>
          <a href="#restos">Commander</a>
        </nav>
        <div class="legal">
          <a href="#">Mentions légales</a>
          <a href="#">CGV</a>
          <a href="#">Politique de confidentialité</a>
        </div>
        <p class="copy">© 2026 Burger Nine — bnine.fr · Tous droits réservés</p>
      </div>
    </footer>
