---
// Site nav. On the landing page the links are in-page anchors; everywhere else
// they have to point back home, so `home` prefixes them.
import { fr as t } from '../i18n/fr'
import BnineButton from './theme/BnineButton.astro'
import BnineMenuButton from './theme/BnineMenuButton.astro'

interface Props {
  /** True on the landing page, where the targets are on this page already. */
  home?: boolean
}
const { home = false } = Astro.props
const to = (hash: string) => (home ? hash : `/${hash}`)
// "La carte" now points at the real full-menu page, not an in-page anchor —
// on the homepage it still lands on the curated teaser section first via #carte,
// but the label's real destination is the /carte catalogue.
---

<header class="nav">
  <div class="nav-in">
    <a href={home ? '#top' : '/'} class="nav-logo" aria-label={t.nav.homeAria}>
      <img src="/assets/f4c82effa1f42578.png" alt="Burger Nine" />
    </a>
    <BnineMenuButton label={t.nav.openMenuAria} controls="nav-dropdown" />
  </div>
  <nav class="nav-dropdown" id="nav-dropdown">
    <a class="lnk" href="/carte">{t.nav.carte}</a>
    <a class="lnk" href={to('#hits')}>{t.nav.hits}</a>
    <a class="lnk" href={to('#spot')}>{t.nav.spot}</a>
    <a class="lnk" href={to('#restos')}>{t.nav.restos}</a>
    <a class="lnk" href={to('#franchise')}>{t.nav.franchise}</a>
    <a class="lnk" href="/carrieres">{t.nav.carrieres}</a>
    <a class="lnk" href="/mes-commandes">{t.nav.commandes}</a>
    <BnineButton href={to('#restos')} arrow>
      {t.nav.commander}
    </BnineButton>
  </nav>
</header>

<script>
  const btn = document.querySelector<HTMLButtonElement>('.nav-menu-btn')
  const dropdown = document.getElementById('nav-dropdown')
  if (btn && dropdown) {
    const close = () => {
      btn.setAttribute('aria-expanded', 'false')
      dropdown.classList.remove('open')
    }
    btn.addEventListener('click', () => {
      const open = btn.getAttribute('aria-expanded') === 'true'
      btn.setAttribute('aria-expanded', String(!open))
      dropdown.classList.toggle('open', !open)
    })
    dropdown.querySelectorAll('a').forEach((a) => a.addEventListener('click', close))
    document.addEventListener('click', (e) => {
      if (!dropdown.contains(e.target as Node) && !btn.contains(e.target as Node)) close()
    })
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') close()
    })
  }
</script>
