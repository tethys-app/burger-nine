---
// Site nav. On the landing page the links are in-page anchors; everywhere else
// they have to point back home, so `home` prefixes them.
interface Props {
  /** True on the landing page, where the targets are on this page already. */
  home?: boolean
}
const { home = false } = Astro.props
const to = (hash: string) => (home ? hash : `/${hash}`)
// "La carte" now points at the real full-menu page, not an in-page anchor —
// on the homepage it still lands on the curated teaser section first via #carte,
// but the label's real destination is the /carte catalogue.
---

<header class="nav">
  <div class="nav-in">
    <div class="nav-side left">
      <a class="lnk" href="/carte">La carte</a>
      <a class="lnk" href={to('#hits')}>Les hits</a>
    </div>
    <a href={home ? '#top' : '/'} class="nav-logo" aria-label="Burger Nine — accueil">
      <img src="/assets/f4c82effa1f42578.png" alt="Burger Nine" />
    </a>
    <div class="nav-side right">
      <a class="lnk" href={to('#restos')}>Nos restos</a>
      <a class="lnk" href="/carrieres">Carrières</a>
      <button
        class="nav-menu-btn"
        aria-label="Ouvrir le menu"
        aria-expanded="false"
        aria-controls="nav-dropdown"
      >
        <span></span>
        <span></span>
        <span></span>
      </button>
    </div>
  </div>
  <nav class="nav-dropdown" id="nav-dropdown">
    <a class="lnk" href="/carte">La carte</a>
    <a class="lnk" href={to('#hits')}>Les hits</a>
    <a class="lnk" href={to('#restos')}>Nos restos</a>
    <a class="lnk" href={to('#franchise')}>Franchise</a>
    <a class="lnk" href="/carrieres">Carrières</a>
    <a href={to('#restos')} class="btn bn-cta">
      Commander
      <svg viewBox="0 0 10 12" fill="currentColor" aria-hidden="true">
        <path d="M0 0l10 6-10 6z"></path>
      </svg>
    </a>
  </nav>
</header>

<script>
  const btn = document.querySelector<HTMLButtonElement>('.nav-menu-btn')
  const dropdown = document.getElementById('nav-dropdown')
  if (btn && dropdown) {
    const close = () => {
      btn.setAttribute('aria-expanded', 'false')
      dropdown.classList.remove('open')
    }
    btn.addEventListener('click', () => {
      const open = btn.getAttribute('aria-expanded') === 'true'
      btn.setAttribute('aria-expanded', String(!open))
      dropdown.classList.toggle('open', !open)
    })
    dropdown.querySelectorAll('a').forEach((a) => a.addEventListener('click', close))
    document.addEventListener('click', (e) => {
      if (!dropdown.contains(e.target as Node) && !btn.contains(e.target as Node)) close()
    })
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') close()
    })
  }
</script>
