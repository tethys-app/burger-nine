---
// Layout for the ordering pages. It loads the brand stylesheet so the palette,
// fonts and chrome are the site's, then remaps the handful of tokens order.css
// is written against onto brand variables. The order UI keeps its own dense
// layout — only the skin changes.
import '../styles/brand.css'
import '../styles/tasty.css'
import '../styles/order.css'

interface Props {
  title: string
  description?: string
}
const { title, description } = Astro.props
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    <link rel="icon" type="image/png" href="/assets/4f5b8c7fd0603355.png" />
    <slot name="head" />
  </head>
  <body class="order-page">
    <div class="grain" aria-hidden="true"></div>
    <slot />
    <style is:global>
      :root {
        color-scheme: dark;
        /* order.css and the islands are written against these five tokens.
           Pointing them at the brand palette re-skins the whole order UI
           without touching its layout. */
        --bg: #0b0a0d;
        --pink: #e0218a;
        --pink-hot: #e0218a;
        --pink-deep: #7a2f8f;
        --panel: #1c1520;
        --line: rgb(200 120 220 / 0.18);
        --txt: #f5ebff;
        --muted: #b8abc7;
        --magenta: #e0218a;
        --violet: #e0218a;
        --violet-deep: #7a2f8f;
        --yellow: #ffc42e;
        --night: #0b0a0d;
        --fg: var(--txt);
        --accent: var(--pink);
        --danger: #ff475c;
        /* Panel surfaces, replacing order.css's hardcoded near-blacks. */
        --surface: var(--panel);
        --surface-raised: #241d2c;
        font-family: var(--body);
      }
      * { box-sizing: border-box; }
      /* Keep the landing-page artwork inside the viewport without making
         `html`/`body` scroll containers. `hidden` breaks descendants using
         `position: sticky` (the category rail and desktop header); `clip`
         preserves the visual guard without changing their containing block. */
      html,
      body.order-page {
        overflow-x: clip;
        overflow-y: visible;
      }
      body {
        margin: 0;
        background: var(--bg);
        color: var(--txt);
        font-size: 15px;
        line-height: 1.5;
        -webkit-font-smoothing: antialiased;
      }
      h1, h2, h3 { font-family: var(--display); font-weight: 800; letter-spacing: 0.01em; }
      /* No default border: the menu components are Tailwind-styled and set their
         own. A global border here lands on every nav item and card button. */
      /* No `background: none` / `border` here: both have the same specificity as
         a Tailwind utility and would silently beat `bg-gradient-to-br` and
         `border-*` on every button in the menu components. Tailwind's preflight
         already neutralises button chrome. */
      button { font: inherit; color: inherit; cursor: pointer; }
      button:disabled { opacity: 0.4; cursor: not-allowed; }
      .primary {
        background: linear-gradient(180deg, var(--pink-hot), var(--pink-deep));
        color: #fff;
        border: none;
        border-radius: 999px;
        padding: 13px 18px;
        width: 100%;
        font-family: var(--display);
        font-weight: 800;
        font-size: 15px;
        letter-spacing: 0.06em;
        text-transform: uppercase;
        transition: transform 0.2s, filter 0.2s;
      }
      .primary:not(:disabled):hover { transform: translateY(-1px); filter: brightness(1.08); }
      input {
        font: inherit;
        background: rgba(0, 0, 0, 0.25);
        color: var(--txt);
        border: 1px solid var(--line);
        border-radius: 12px;
        padding: 11px 13px;
        width: 100%;
      }
      input:focus-visible { outline: 2px solid var(--pink); outline-offset: 1px; }
      .price { color: var(--muted); font-variant-numeric: tabular-nums; }
      .error, .blocker { color: var(--danger); }
      /* Totals dim rather than disappear while a quote is in flight, so the
         layout never shifts. */
      .totals[data-stale='true'] { opacity: 0.55; }
    </style>
  </body>
</html>
