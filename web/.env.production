# Loaded automatically by `astro build` (mode=production), locally and in CI.
#
# Committed on purpose: invariant #2 means nothing in here is a secret. Every
# value is PUBLIC_ and ships in the JS bundle anyway — the Stripe publishable
# key arrives at runtime from GET /store, not from here.
PUBLIC_NEO_API_URL=https://friendly-hummingbird-971.eu-west-1.convex.site
PUBLIC_BRAND_SLUG=burger-nine
PUBLIC_SITE_URL=https://burger-nine.tethy.sh
